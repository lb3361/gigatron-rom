                                          7812  # Instruction COPY (35 cb)
                                          7813  # * Copy up to vAC (max 256) bytes from [T3] to [T2]
                                          7814  # * Handles page crossings. Peak rate 10 bytes/scanline.
                                          7815  # * On return, T3 and T2 contain the next addresses
                                          7816  #   and vAC contains the number of bytes left to copy.
                                          7817  # * Origin: this is an improved version of the copy
                                          7818  #   opcode I wrote for ROMvX0.
                                          7819  oplabel('COPY_v7')
