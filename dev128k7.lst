                                          2995  #
                                          2996  #  $0500 ROM page 5-6: Shift table and code
                                          2997  #
                                          2998  #-----------------------------------------------------------------------
                                          2999
                                          3000  align(0x100, size=0x200)
                                          3001
                                          3002  # Lookup table for i>>n, with n in 1..6
                                          3003  # Indexing ix = i & ~b | (b-1), where b = 1<<(n-1)
                                          3004  #       ...
                                          3005  #       ld   <.ret
                                          3006  #       st   [vTmp]
                                          3007  #       ld   >shiftTable,y
                                          3008  #       <calculate ix>
                                          3009  #       jmp  y,ac
                                          3010  #       bra  $ff
                                          3011  # .ret: ...
                                          3012  #
                                          3013  # i >> 7 can be always be done with RAM: [i&128]
                                          3014  #       ...
                                          3015  #       anda $80,x
                                          3016  #       ld   [x]
                                          3017  #       ...
                                          3018
                                          3019  label('shiftTable')
                                          3020  shiftTable = pc()
                                          3021
                                          3022  for ix in range(255):
                                          3023    for n in range(1,7): # Find first zero
                                          3024      if ~ix & (1 << (n-1)):
                                          3025        break
                                          3026    pattern = ['x' if i<n else '1' if ix&(1<<i) else '0' for i in range(8)]
                                          3027    ld(ix>>n); C('0b%s >> %d' % (''.join(reversed(pattern)), n))
