                                          5986  label('sys_ResetWaveforms')
sys_ResetWaveforms:
              125f 0118  ld   [$18]       5987  ld([vAC+0])                     #18 X=4i
              1260 8200  adda ac          5988  adda(AC)                        #19
              1261 9200  adda ac,x        5989  adda(AC,X)                      #20
              1262 0118  ld   [$18]       5990  ld([vAC+0])                     #21
              1263 de00  st   [y,x++]     5991  st([Y,Xpp])                     #22 Sawtooth: T[4i+0] = i
              1264 2020  anda $20         5992  anda(0x20)                      #23 Triangle: T[4i+1] = 2i if i<32 else 127-2i
              1265 ec68  bne  $1268       5993  bne(pc()+3)                     #24
              1266 0118  ld   [$18]       5994  ld([vAC+0])                     #25
              1267 fc6a  bra  $126a       5995  bra(pc()+3)                     #26
              1268 8118  adda [$18]       5996  adda([vAC+0])                   #26,27
              1269 607f  xora $7f         5997  xora(127)                       #27
              126a de00  st   [y,x++]     5998  st([Y,Xpp])                     #28
              126b 0118  ld   [$18]       5999  ld([vAC+0])                     #29 Pulse: T[4i+2] = 0 if i<32 else 63
              126c 2020  anda $20         6000  anda(0x20)                      #30
              126d ec70  bne  $1270       6001  bne(pc()+3)                     #31
              126e fc71  bra  $1271       6002  bra(pc()+3)                     #32
              126f 0000  ld   $00         6003  ld(0)                           #33
