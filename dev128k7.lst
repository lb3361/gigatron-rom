              00b7 e0cb  jmp  y,$cb       970   jmp(Y,'REENTER')                #16
              00b8 00f6  ld   $f6         971   ld(-20/2)                       #17
                                          972
              00b9 1403  ld   $03,y       973   ld(hi('REENTER'),Y)             #15 slot 0xb9
              00ba e0cb  jmp  y,$cb       974   jmp(Y,'REENTER')                #16
              00bb 00f6  ld   $f6         975   ld(-20/2)                       #17
