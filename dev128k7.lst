                                          2818  #-----------------------------------------------------------------------
                                          2819  #
                                          2820  #  vCPU extension functions (for acceleration and compaction) follow below.
                                          2821  #
                                          2822  #  The naming convention is: SYS_<CamelCase>[_v<V>]_<N>
                                          2823  #
                                          2824  #  With <N> the maximum number of cycles the function will run
                                          2825  #  (counted from NEXT to NEXT). This is the same number that must
                                          2826  #  be passed to the 'SYS' vCPU instruction as operand, and it will
                                          2827  #  appear in the GCL code upon use.
                                          2828  #
                                          2829  #  If a SYS extension got introduced after ROM v1, the version number of
                                          2830  #  introduction is included in the name. This helps the programmer to be
                                          2831  #  reminded to verify the acutal ROM version and fail gracefully on older
                                          2832  #  ROMs than required. See also Docs/GT1-files.txt on using [romType].
                                          2833  #
                                          2834  #-----------------------------------------------------------------------
                                          2835
              04a4 0200  nop              2836  fillers(until=0xa7)
              04a5 0200  nop
              04a6 0200  nop
                                          2837
                                          2838  #-----------------------------------------------------------------------
                                          2839  # Extension SYS_Random_34: Update entropy and copy to vAC
                                          2840  #-----------------------------------------------------------------------
                                          2841
                                          2842  # This same algorithm runs automatically once per vertical blank.
                                          2843  # Use this function to get numbers at a higher rate.
                                          2844  #
                                          2845  # Variables:
                                          2846  #       vAC
                                          2847
                                          2848  label('SYS_Random_34')
SYS_Random_34:
              04a7 0115  ld   [$15]       2849  ld([vTicks])                    #15
              04a8 6107  xora [$07]       2850  xora([entropy+1])               #16
              04a9 1401  ld   $01,y       2851  ld(1,Y)                         #17
              04aa 8106  adda [$06]       2852  adda([entropy+0])               #18
              04ab c206  st   [$06]       2853  st([entropy+0])                 #19
              04ac c218  st   [$18]       2854  st([vAC+0])                     #20
                                          2855  if WITH_128K_BOARD:
              04ad 89f2  adda [y,$f2]     2856    adda([Y,entropy2])            #21
              04ae caf2  st   [y,$f2]     2857    st([Y,entropy2])              #22
                                          2858  else:
                                          2859    adda([entropy+2])             #21
                                          2860    st([entropy+2])               #22
              04af e8b2  blt  .sysRnd0    2861  bmi('.sysRnd0')                 #23
              04b0 fcb3  bra  .sysRnd1    2862  bra('.sysRnd1')                 #24
              04b1 6053  xora $53         2863  xora(64+16+2+1)                 #25
                                          2864  label('.sysRnd0')
.sysRnd0:     04b2 606c  xora $6c         2865  xora(64+32+8+4)                 #25
                                          2866  label('.sysRnd1')
.sysRnd1:     04b3 8107  adda [$07]       2867  adda([entropy+1])               #26
              04b4 c207  st   [$07]       2868  st([entropy+1])                 #27
              04b5 c219  st   [$19]       2869  st([vAC+1])                     #28
              04b6 1403  ld   $03,y       2870  ld(hi('REENTER'),Y)             #29
              04b7 e0cb  jmp  y,$cb       2871  jmp(Y,'REENTER')                #30
              04b8 00ef  ld   $ef         2872  ld(-34/2)                       #31
