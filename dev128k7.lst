              0e83 60be  xora $be         4822  xora(0xbe)                      #29
              0e84 f087  beq  $0e87       4823  beq(pc()+3)                     #30
              0e85 fc88  bra  $0e88       4824  bra(pc()+3)                     #31
              0e86 0124  ld   [$24]       4825  ld([v6502_ADL])                 #32
