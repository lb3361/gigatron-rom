                                          1477  #
                                          1478  # This is executed during the last video blanking line.
                                          1479  # It sets up things for the visible lines that follow
                                          1480
                                          1481  label('.vBlankLast#32')
.vBlankLast#32:
              019e e028  jmp  y,$28       1482  jmp(Y,'vBlankLast#34')          #32 Jump out of page for space reasons
              019f 1401  ld   $01,y       1483  ld(hi(pc()),Y)                  #33
                                          1484
                                          1485  label('vBlankLast#52')
                                          1486
                                          1487  # Respond to reset button (14 cycles)
                                          1488  # - ResetTimer decrements as long as just [Start] is pressed down
                                          1489  # - Reaching 0 (normal) or 128 (extended) triggers the soft reset sequence
                                          1490  # - Initial value is 128 (or 255 at boot), first decrement, then check
                                          1491  # - This starts vReset -> SYS_Reset_88 -> SYS_Exec_88 -> Reset.gcl -> Main.gcl
                                          1492  # - Main.gcl then recognizes extended presses if resetTimer is 0..127 ("paasei")
                                          1493  # - This requires a full cycle (4s) in the warm boot scenario
                                          1494  # - Or a half cycle (2s) when pressing [Select] down during hard reset
                                          1495  # - This furthermore requires >=1 frame (and <=128) to have passed between
                                          1496  #   reaching 128 and getting through Reset and the start of Main, while [Start]
                                          1497  #   was still pressed so the count reaches <128. Two reasonable expectations.
                                          1498  # - The unintended power-up scenarios of ROMv1 (pulling SER_DATA low, or
                                          1499  #   pressing [Select] together with another button) now don't trigger anymore.
                                          1500
vBlankLast#52:
              01a0 0111  ld   [$11]       1501  ld([buttonState])               #52 Check [Start] for soft reset
              01a1 60ef  xora $ef         1502  xora(~buttonStart)              #53
              01a2 ecab  bne  .restart#56 1503  bne('.restart#56')              #54
              01a3 0112  ld   [$12]       1504  ld([resetTimer])                #55 As long as button pressed
              01a4 a001  suba $01         1505  suba(1)                         #56 ... count down the timer
              01a5 c212  st   [$12]       1506  st([resetTimer])                #57
              01a6 207f  anda $7f         1507  anda(127)                       #58
              01a7 f0b3  beq  .restart#61 1508  beq('.restart#61')              #59 Reset at 0 (normal 2s) or 128 (extended 4s)
              01a8 00ee  ld   $ee         1509  ld((vReset&255)-2)              #60 Start force reset when hitting 0
              01a9 fcb2  bra  .restart#63 1510  bra('.restart#63')              #61 ... otherwise do nothing yet
              01aa fcb1  bra  .restart#64 1511  bra('.restart#64')              #62
                                          1512  label('.restart#56')
.restart#56:  01ab 0001  ld   $01         1513  wait(62-56)                     #56
              01ac ecac  bne  $01ac
              01ad a001  suba $01
              01ae 0200  nop
              01af 0080  ld   $80         1514  ld(128)                         #62 Not pressed, reset the timer
              01b0 c212  st   [$12]       1515  st([resetTimer])                #63
                                          1516  label('.restart#64')
.restart#64:  01b1 fcb8  bra  .restart#66 1517  bra('.restart#66')              #64
                                          1518  label('.restart#63')
.restart#63:  01b2 0200  nop              1519  nop()                           #63,65
                                          1520  label('.restart#61')
.restart#61:  01b3 c216  st   [$16]       1521  st([vPC])                       #61 Point vPC at vReset
              01b4 0001  ld   $01         1522  ld(vReset>>8)                   #62
              01b5 c217  st   [$17]       1523  st([vPC+1])                     #63
              01b6 0002  ld   $02         1524  ld(hi('ENTER'))                 #64 Set active interpreter to vCPU
              01b7 c205  st   [$05]       1525  st([vCpuSelect])                #65
                                          1526  label('.restart#66')
                                          1527
                                          1528  # Sets vReturn and nextVideo for visible lines
.restart#66:  01b8 00e3  ld   $e3         1529  ld(lo('vVisibEnter'))           #66
              01b9 c21e  st   [$1e]       1530  st([vReturn])                   #67
              01ba 1401  ld   $01,y       1531  ld(videoTop_v5>>8,Y)            #68
              01bb 09f9  ld   [y,$f9]     1532  ld([Y,videoTop_v5])             #69
              01bc c209  st   [$09]       1533  st([videoY])                    #70
              01bd c21f  st   [$1f]       1534  st([frameX])                    #71
              01be ecc1  bne  $01c1       1535  bne(pc()+3)                     #72
              01bf fcc2  bra  $01c2       1536  bra(pc()+3)                     #73
              01c0 0001  ld   $01         1537  ld('videoA')                    #74
              01c1 00ec  ld   $ec         1538  ld('videoF')                    #74(!)
              01c2 c20d  st   [$0d]       1539  st([nextVideo])                 #75
              01c3 0102  ld   [$02]       1540  ld([channel])                   #76 Normalize channel for robustness
              01c4 2003  anda $03         1541  anda(0b00000011)                #77
              01c5 c202  st   [$02]       1542  st([channel])                   #78
                                          1543
                                          1544
                                          1545  # Switch video mode when (only) select is pressed (16 cycles)
                                          1546  # XXX We could make this a vCPU interrupt
              01c6 0111  ld   [$11]       1547  ld([buttonState])               #79 Check [Select] to switch modes
              01c7 60df  xora $df         1548  xora(~buttonSelect)             #80 Only trigger when just [Select] is pressed
              01c8 f0cc  beq  .select#83  1549  beq('.select#83')               #81
              01c9 1505  ld   [$05],y     1550  runVcpu_new(vVisibEnterCyc-82,  #82 vCPU
              01ca e0ff  jmp  y,$ff
              01cb 0026  ld   $26
                                          1551            '---D line 40 no select')
                                          1552
                                          1553  label('.select#83')
                                          1554  if not WITH_512K_BOARD:
.select#83:   01cc 010b  ld   [$0b]       1555    ld([videoModeC])              #83
              01cd e8d3  blt  .select#86  1556    bmi('.select#86')             #84 Branch when line C is off
              01ce 010a  ld   [$0a]       1557    ld([videoModeB])              #85 Rotate: Off->D->B->C
              01cf c20b  st   [$0b]       1558    st([videoModeC])              #86
              01d0 010c  ld   [$0c]       1559    ld([videoModeD])              #87
              01d1 c20a  st   [$0a]       1560    st([videoModeB])              #88
              01d2 fcd8  bra  .select#91  1561    bra('.select#91')             #89
                                          1562    label('.select#86')
.select#86:   01d3 00f6  ld   $f6         1563    ld('nopixels')                #86,90
              01d4 000a  ld   $0a         1564    ld('pixels')                  #87 Reset: On->D->B->C
              01d5 c20b  st   [$0b]       1565    st([videoModeC])              #88
              01d6 c20a  st   [$0a]       1566    st([videoModeB])              #89
              01d7 0200  nop              1567    nop()                         #90
                                          1568    label('.select#91')
.select#91:   01d8 c20c  st   [$0c]       1569    st([videoModeD])              #91
                                          1570  else:
                                          1571    ld([videoModeB])              #83
                                          1572    xora('nopixels')              #84
                                          1573    beq('.select#87')             #85
                                          1574    ld([videoModeD])              #86
                                          1575    st([videoModeB])              #87
                                          1576    bra('.select#90')             #88
                                          1577    ld('nopixels')                #89
                                          1578    label('.select#87')
                                          1579    ld('pixels')                  #87
                                          1580    st([videoModeB])              #88
                                          1581    nop()                         #89
                                          1582    label('.select#90')
                                          1583    st([videoModeD])              #90
                                          1584    nop()                         #91
                                          1585
              01d9 00ff  ld   $ff         1586  ld(255)                         #92
              01da c211  st   [$11]       1587  st([buttonState])               #93
              01db 1505  ld   [$05],y     1588  runVcpu_new(vVisibEnterCyc-94,  #94
              01dc e0ff  jmp  y,$ff
              01dd 0020  ld   $20
