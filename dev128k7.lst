                                          3248  #-----------------------------------------------------------------------
                                          3249  # Extension SYS_Read3_40
                                          3250  #-----------------------------------------------------------------------
                                          3251
                                          3252  # Read 3 consecutive bytes from ROM
                                          3253  #
                                          3254  # Note: This function a bit obsolete, as it has very limited use. It's
                                          3255  #       effectively an application-specific SYS function for the Pictures
                                          3256  #       application from ROM v1. It requires the ROM data be organized
                                          3257  #       with trampoline3a and trampoline3b fragments, and their address
                                          3258  #       in ROM to be known. Better avoid using this.
                                          3259  # Variables:
                                          3260  #       sysArgs[0:2]    Bytes (out)
                                          3261  #       sysArgs[6:7]    ROM pointer (in)
                                          3262
                                          3263  fillers(until = 0xb9)
                                          3264  assert pc() == 0x6b9
                                          3265
                                          3266  label('SYS_Read3_40')
SYS_Read3_40: 06b9 152b  ld   [$2b],y     3267  ld([sysArgs+7],Y)               #15,43
              06ba e079  jmp  y,$79       3268  jmp(Y,128-7)                    #16 trampoline3a
              06bb 012a  ld   [$2a]       3269  ld([sysArgs+6])                 #17
                                          3270  label('txReturn')
txReturn:     06bc c226  st   [$26]       3271  st([sysArgs+2])                 #34
              06bd 1403  ld   $03,y       3272  ld(hi('REENTER'),Y)             #35
              06be e0cb  jmp  y,$cb       3273  jmp(Y,'REENTER')                #36
              06bf 00ec  ld   $ec         3274  ld(-40/2)                       #37
                                          3275
                                          3276  def trampoline3a():
                                          3277    """Read 3 bytes from ROM page"""
                                          3278    while pc()&255 < 128-7:
                                          3279      nop()
                                          3280    bra(AC)                       #18
                                          3281    C('Trampoline for page $%02x00 reading (entry)' % (pc()>>8))
                                          3282    bra(123)                      #19
                                          3283    st([sysArgs+0])               #21
                                          3284    ld([sysArgs+6])               #22
                                          3285    adda(1)                       #23
                                          3286    bra(AC)                       #24
                                          3287    bra(250)                      #25 trampoline3b
                                          3288    align(1, size=0x80)
                                          3289
                                          3290  def trampoline3b():
                                          3291    """Read 3 bytes from ROM page (continue)"""
                                          3292    while pc()&255 < 256-6:
                                          3293      nop()
                                          3294    st([sysArgs+1])               #27
                                          3295    C('Trampoline for page $%02x00 reading (continue)' % (pc()>>8))
                                          3296    ld([sysArgs+6])               #28
                                          3297    adda(2)                       #29
                                          3298    ld(hi('txReturn'),Y)          #30
                                          3299    bra(AC)                       #31
                                          3300    jmp(Y,'txReturn')             #32
                                          3301    align(1, size=0x100)
                                          3302
