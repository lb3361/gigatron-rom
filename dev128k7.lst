                                          2957  # vRTI immediate resume
                                          2958  label('vRTI#32')
vRTI#32:      04eb 1505  ld   [$05],y     2959  ld([vCpuSelect],Y)              #32
              04ec 00ee  ld   $ee         2960  ld(-36//2)                      #33
              04ed e0ff  jmp  y,$ff       2961  jmp(Y,'ENTER')                  #34
              04ee 8115  adda [$15]       2962  adda([vTicks])                  #35-36=-1
                                          2963
                                          2964  # Immediate resume is possible when there is enough time for
                                          2965  # finishing vrti and executing the next instruction (possibly v6502)
                                          2966  vRtiNeeds=36//2+maxTicks+v6502_adjust
                                          2967
                                          2968  label('vRTI#22')
vRTI#22:      04ef 0132  ld   [$32]       2969  ld([vIrqSave+2])                #22
              04f0 c218  st   [$18]       2970  st([vAC])                       #23
