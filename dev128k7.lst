                                          4045  #-----------------------------------------------------------------------
                                          4046  # Extension SYS_Sprite6_v3_64
                                          4047  # Extension SYS_Sprite6x_v3_64
                                          4048  # Extension SYS_Sprite6y_v3_64
                                          4049  # Extension SYS_Sprite6xy_v3_64
                                          4050  #-----------------------------------------------------------------------
                                          4051
                                          4052  # Blit sprite in screen memory
                                          4053  #
                                          4054  # Variables
                                          4055  #       vAC             Destination address in screen
                                          4056  #       sysArgs[0:1]    Source address of 6xY pixels (colors 0..63) terminated
                                          4057  #                       by negative byte value N (typically N = -Y)
                                          4058  #       sysArgs[2:7]    Scratch (user as copy buffer)
                                          4059  #
                                          4060  # This SYS function draws a sprite of 6 pixels wide and Y pixels high.
                                          4061  # The pixel data is read sequentually from RAM, in horizontal chunks
                                          4062  # of 6 pixels at a time, and then written to the screen through the
                                          4063  # destination pointer (each chunk underneath the previous), thus
                                          4064  # drawing a 6xY stripe. Pixel values should be non-negative. The first
                                          4065  # negative byte N after a chunk signals the end of the sprite data.
                                          4066  # So the sprite's height Y is determined by the source data and is
                                          4067  # therefore flexible. This negative byte value, typically N == -Y,
                                          4068  # is then used to adjust the destination pointer's high byte, to make
                                          4069  # it easier to draw sprites wider than 6 pixels: just repeat the SYS
                                          4070  # call for as many 6-pixel wide stripes you need. All arguments are
                                          4071  # already left in place to facilitate this. After one call, the source
                                          4072  # pointer will point past that source data, effectively:
                                          4073  #       src += Y * 6 + 1
                                          4074  # The destination pointer will have been adjusted as:
                                          4075  #       dst += (Y + N) * 256 + 6
                                          4076  # (With arithmetic wrapping around on the same memory page)
                                          4077  #
                                          4078  # Y is only limited by source memory, not by CPU cycles. The
                                          4079  # implementation is such that the SYS function self-repeats, each
                                          4080  # time drawing the next 6-pixel chunk. It can typically draw 12
                                          4081  # pixels per scanline this way.
                                          4082
                                          4083  label('SYS_Sprite6_v3_64')
                                          4084
SYS_Sprite6_v3_64:
              0c00 1124  ld   [$24],x     4085  ld([sysArgs+0],X)               #15 Pixel data source address
              0c01 1525  ld   [$25],y     4086  ld([sysArgs+1],Y)               #16
              0c02 0d00  ld   [y,x]       4087  ld([Y,X])                       #17 Next pixel or stop
              0c03 f411  bge  .sysDpx0    4088  bpl('.sysDpx0')                 #18
              0c04 de00  st   [y,x++]     4089  st([Y,Xpp])                     #19 Just X++
                                          4090
              0c05 8119  adda [$19]       4091  adda([vAC+1])                   #20 Adjust dst for convenience
