                                          4640  # All interpreter entry points must share the same page offset, because
                                          4641  # this offset is hard-coded as immediate operand in the video driver.
                                          4642  # The Gigatron's original vCPU's 'ENTER' label is already at $2ff, so we
                                          4643  # just use $dff for 'v6502_ENTER'. v6502 actually has two entry points.
                                          4644  # The other is 'v6502_RESUME' at $10ff. It is used for instructions
                                          4645  # that were fetched but not yet executed. Allowing the split gives finer
                                          4646  # granulariy, and hopefully more throughput for the simpler instructions.
                                          4647  # (There is no "overhead" for allowing instruction splitting, because
                                          4648  #  both emulation phases must administer [vTicks] anyway.)
                                          4649
              0dfc 0200  nop              4650  fillers(until=0xff)
              0dfd 0200  nop
              0dfe 0200  nop
