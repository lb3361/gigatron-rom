                                          5118  # Carry calculation table
                                          5119  #   L7 R7 C7   RX UC SC
                                          5120  #   -- -- -- | -- -- --
                                          5121  #    0  0  0 |  0  0  0
                                          5122  #    0  0  1 |  0  0  0
                                          5123  #    1  0  0 |  0  1 +1
                                          5124  #    1  0  1 |  0  0  0
                                          5125  #    0  1  0 | -1  1  0
                                          5126  #    0  1  1 | -1  0 -1
                                          5127  #    1  1  0 | -1  1  0
                                          5128  #    1  1  1 | -1  1  0
                                          5129  #   -- -- -- | -- -- --
                                          5130  #    ^  ^  ^    ^  ^  ^
                                          5131  #    |  |  |    |  |  `--- Carry of unsigned L + signed R: SC = RX + UC
                                          5132  #    |  |  |    |  `----- Carry of unsigned L + unsigned R: UC = C7 ? L7&R7 : L7|R7
                                          5133  #    |  |  |    `------- Sign extension of signed R
                                          5134  #    |  |  `--------- MSB of unextended L + R
                                          5135  #    |  `----------- MSB of right operand R
                                          5136  #    `------------- MSB of left operand L
                                          5137
