                                          1101  # Extension SYS_CopyMemory_v6_80
                                          1102  #-----------------------------------------------------------------------
                                          1103
                                          1104  # SYS function for copying 1..256 bytes
                                          1105  #
                                          1106  # sysArgs[0:1]    Destination address
                                          1107  # sysArgs[2:3]    Source address
                                          1108  # vAC[0]          Count (0 means 256)
                                          1109  #
                                          1110  # Doesn't cross page boundaries.
                                          1111  # Overwrites sysArgs[4:7] and vLR.
                                          1112
                                          1113  label('SYS_CopyMemory_v6_80')
SYS_CopyMemory_v6_80:
              00e9 1413  ld   $13,y       1114  ld(hi('sys_CopyMemory'),Y)       # 15 slot 0xe9
              00ea e000  jmp  y,$00       1115  jmp(Y, 'sys_CopyMemory')         # 16
              00eb 0118  ld   [$18]       1116  ld([vAC])                        # 17
                                          1117
                                          1118  #-----------------------------------------------------------------------
                                          1119  # Extension SYS_CopyMemoryExt_v6_100
                                          1120  #-----------------------------------------------------------------------
                                          1121
                                          1122  # SYS function for copying 1..256 bytes across banks
                                          1123  #
                                          1124  # sysArgs[0:1]  Destination address
                                          1125  # sysArgs[2:3]  Source address
                                          1126  # vAC[0]        Count (0 means 256)
                                          1127  # vAC[1]        Bits 7 and 6 contain the destination bank number,
                                          1128  #               and bits 5 and 4 the source bank number.
                                          1129  #
                                          1130  # Doesn't cross page boundaries.
                                          1131  # Overwrites sysArgs[4:7], vLR, and vTmp.
                                          1132  # Temporarily deselect all SPI devices.
