                                          10504  #----------------------------------------
                                          10505  # LUP implementation
                                          10506
                                          10507  # LUP on dev7rom runs 4 cycles behind earlier ROMS.
                                          10508  # Clearing [vAC+1] is now achieved before branching
                                          10509  # into the rom page instead of in the return suffix.
                                          10510  # This permits sys_Exec to consult the ROM tables
                                          10511  # without losing the contents of [vAC+1] and with
                                          10512  # enough time to increment the lup pointer.
                                          10513  label('lup#13')
lup#13:       2000 1519  ld   [$19],y     10514  ld([vAC+1],Y)                   #13
              2001 1019  ld   $19,x       10515  ld(vAC+1,X)                     #14
              2002 e0fb  jmp  y,$fb       10516  jmp(Y,251)                      #15
              2003 c400  st   $00,[x]     10517  st(0,[X])                       #16 clear [vAC+1]
                                          10518
                                          10519  # The LUP return stub name 'lupReturn#19' is hardcoded in the
                                          10520  # trampoline code which cannot be changed because asm.py must
                                          10521  # remain able to compile older roms.
                                          10522  label('lupReturn#19')           # name hardcoded in the trampoline code
                                          10523  label('lupReturn#23')           # same name with the proper timing suffix
lupReturn#19:
lupReturn#23: 2004 0105  ld   [$05]       10524  ld([vCpuSelect])                #23 to current interpreter
              2005 9401  adda $01,y       10525  adda(1,Y)                       #24
              2006 00f2  ld   $f2         10526  ld(-28/2)                       #25
              2007 e001  jmp  y,$01       10527  jmp(Y,'NEXT')                   #26 using NEXT
              2008 1517  ld   [$17],y     10528  ld([vPC+1],Y)                   #27
