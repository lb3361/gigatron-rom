                                          5871
                                          5872  #-----------------------------------------------------------------------
                                          5873  #       Extended vertical blank logic: game controller decoding
                                          5874  #-----------------------------------------------------------------------
                                          5875
                                          5876  # Entered last line of vertical blank (line 40)
                                          5877  label('vBlankLast#34')
                                          5878
                                          5879  # Game controller types
                                          5880  # TypeA: Based on 74LS165 shift register (not supported)
                                          5881  # TypeB: Based on CD4021B shift register (standard)
                                          5882  # TypeC: Based on priority encoder
                                          5883  #
                                          5884  # Notes:
                                          5885  # - TypeA was only used during development and first beta test, before ROM v1
                                          5886  # - TypeB appears as type A with negative logic levels
                                          5887  # - TypeB is the game controller type that comes with the original kit and ROM v1
                                          5888  # - TypeB is mimicked by BabelFish / Pluggy McPlugface
                                          5889  # - TypeB requires a prolonged /SER_LATCH, therefore vPulse is 8 scanlines, not 2
                                          5890  # - TypeB and TypeC can be sampled in the same scanline
                                          5891  # - TypeA is 1 scanline shifted as it looks at a different edge (XXX up or down?)
                                          5892  # - TypeC gives incomplete information: lower buttons overshadow higher ones
                                          5893  #
                                          5894  #       TypeC    Alias    Button TypeB
                                          5895  #       00000000  ^@   -> Right  11111110
                                          5896  #       00000001  ^A   -> Left   11111101
                                          5897  #       00000011  ^C   -> Down   11111011
                                          5898  #       00000111  ^G   -> Up     11110111
                                          5899  #       00001111  ^O   -> Start  11101111
                                          5900  #       00011111  ^_   -> Select 11011111
                                          5901  #       00111111  ?    -> B      10111111
                                          5902  #       01111111  DEL  -> A      01111111
                                          5903  #       11111111       -> (None) 11111111
                                          5904  #
                                          5905  #       Conversion formula:
                                          5906  #               f(x) := 254 - x
                                          5907
                                          5908  # Detect controller TypeC codes
vBlankLast#34:
              1228 010f  ld   [$0f]       5909  ld([serialRaw])                 #34 if serialRaw in [0,1,3,7,15,31,63,127,255]
              1229 8001  adda $01         5910  adda(1)                         #35
              122a 210f  anda [$0f]       5911  anda([serialRaw])               #36
              122b ec3c  bne  .buttons#39 5912  bne('.buttons#39')              #37
                                          5913
                                          5914  # TypeC
              122c 010f  ld   [$0f]       5915  ld([serialRaw])                 #38 [TypeC] if serialRaw < serialLast
              122d 8001  adda $01         5916  adda(1)                         #39
              122e 2110  anda [$10]       5917  anda([serialLast])              #40
              122f ec33  bne  .buttons#43 5918  bne('.buttons#43')              #41
              1230 00fe  ld   $fe         5919  ld(254)                         #42 then clear the selected bit
              1231 0200  nop              5920  nop()                           #43
              1232 fc36  bra  .buttons#46 5921  bra('.buttons#46')              #44
                                          5922  label('.buttons#43')
.buttons#43:  1233 a10f  suba [$0f]       5923  suba([serialRaw])               #43,45
              1234 2111  anda [$11]       5924  anda([buttonState])             #44
              1235 c211  st   [$11]       5925  st([buttonState])               #45
                                          5926  label('.buttons#46')
.buttons#46:  1236 010f  ld   [$0f]       5927  ld([serialRaw])                 #46 Set the lower bits
              1237 4111  ora  [$11]       5928  ora([buttonState])              #47
                                          5929  label('.buttons#48')
.buttons#48:  1238 c211  st   [$11]       5930  st([buttonState])               #48
              1239 010f  ld   [$0f]       5931  ld([serialRaw])                 #49 Update serialLast for next pass
              123a e0a0  jmp  y,$a0       5932  jmp(Y,'vBlankLast#52')          #50
              123b c210  st   [$10]       5933  st([serialLast])                #51
                                          5934
                                          5935  # TypeB
                                          5936  # pChange = pNew & ~pOld
                                          5937  # nChange = nNew | ~nOld {DeMorgan}
                                          5938  label('.buttons#39')
.buttons#39:  123c 00ff  ld   $ff         5939  ld(255)                         #39 [TypeB] Bitwise edge-filter to detect button presses
              123d 6110  xora [$10]       5940  xora([serialLast])              #40
              123e 410f  ora  [$0f]       5941  ora([serialRaw])                #41 Catch button-press events
              123f 2111  anda [$11]       5942  anda([buttonState])             #42 Keep active button presses
              1240 410f  ora  [$0f]       5943  ora([serialRaw])                #43
              1241 0200  nop              5944  nop()                           #44
              1242 0200  nop              5945  nop()                           #45
              1243 fc38  bra  .buttons#48 5946  bra('.buttons#48')              #46
              1244 0200  nop              5947  nop()                           #47
                                          5948
