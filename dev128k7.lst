vbInput#46:   0194 fc91  bra  vbNormal#48 1441    bra('vbNormal#48')            #46
              0195 c30f  st   in,[$0f]    1442    st(IN, [serialRaw])           #47
                                          1443  else:
                                          1444    st(IN, [serialRaw])           #46
