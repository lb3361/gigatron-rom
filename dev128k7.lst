              04f2 c219  st   [$19]       2972  st([vAC+1])                     #25
              04f3 0134  ld   [$34]       2973  ld([vIrqSave+4])                #26
              04f4 c205  st   [$05]       2974  st([vCpuSelect])                #27
              04f5 0115  ld   [$15]       2975  ld([vTicks])                    #28 enough time for immediate resume?
              04f6 80e9  adda $e9         2976  adda(maxTicks-vRtiNeeds)        #29
              04f7 f4eb  bge  vRTI#32     2977  bge('vRTI#32')                  #30
              04f8 1403  ld   $03,y       2978  ld(hi('RESYNC'),Y)              #31
              04f9 e00c  jmp  y,$0c       2979  jmp(Y,'RESYNC')                 #32
              04fa 8017  adda $17         2980  adda(vRtiNeeds-30//2)           #33-30=3
                                          2981
                                          2982  # Resync cycle adjustment must be positive
                                          2983  assert (maxTicks-vRtiNeeds)+(vRtiNeeds-30//2) >= 0
                                          2984
