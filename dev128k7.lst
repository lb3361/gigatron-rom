              1271 de00  st   [y,x++]     6005  st([Y,Xpp])                     #34
              1272 0118  ld   [$18]       6006  ld([vAC+0])                     #35 Sawtooth: T[4i+3] = i
              1273 ce00  st   [y,x]       6007  st([Y,X])                       #36
              1274 8001  adda $01         6008  adda(1)                         #37 i += 1
              1275 c218  st   [$18]       6009  st([vAC+0])                     #38
              1276 6040  xora $40         6010  xora(64)                        #39 For 64 iterations
              1277 f07a  beq  $127a       6011  beq(pc()+3)                     #40
              1278 fc7b  bra  $127b       6012  bra(pc()+3)                     #41
              1279 00fe  ld   $fe         6013  ld(-2)                          #42
              127a 0000  ld   $00         6014  ld(0)                           #42(!)
              127b 8116  adda [$16]       6015  adda([vPC])                     #43
