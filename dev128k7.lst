                                          2516  # The instructions below are all implemented in the second code page. Jumping
                                          2517  # back and forth makes each 6 cycles slower, but it also saves space in the
                                          2518  # primary page for the instructions above. Most of them are in fact not very
                                          2519  # critical, as evidenced by the fact that they weren't needed for the first
                                          2520  # Gigatron applications (Snake, Racer, Mandelbrot, Loader). By providing them
                                          2521  # in this way, at least they don't need to be implemented as a SYS extension.
                                          2522
                                          2523  # Instruction ADDI: Add small positive constant (vAC+=D), 24-26 cycles
                                          2524  label('ADDI')
ADDI:         03e3 1404  ld   $04,y       2525  ld(hi('addi#13'),Y)             #10,12
              03e4 e01c  jmp  y,$1c       2526  jmp(Y,'addi#13')                #11
