                                          1047
                                          1048  #-----------------------------------------------------------------------
                                          1049  # Extension SYS_ScanMemoryExt_v6_50
                                          1050  #-----------------------------------------------------------------------
                                          1051
                                          1052  # SYS function for searching bytes in a different memory bank.
                                          1053  # This function examines bytes starting from address sysArgs[01] with
                                          1054  # the selected bank mapped at addresses 0x8000-0xffff. It stops when
                                          1055  # encountering a byte equal to either sysArgs[2] or sysArgs[3], or
                                          1056  # when vACL bytes have been examined, whichever comes first. It does
                                          1057  # not cross page boudaries but wraps around in page sysArgs[1].
                                          1058  #
                                          1059  # Input:
                                          1060  #   sysArgs[01]        Start address of the string
                                          1061  #   sysArgs[23]        Bytes to search
                                          1062  #   vACL               Length of the string (0 means 256)
                                          1063  #   vACH               Bits 7 and 6 select the bank mapped in 0x8000-0xffff.
                                          1064  #
