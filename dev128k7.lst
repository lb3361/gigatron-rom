                                          1075  #-----------------------------------------------------------------------
                                          1076  # Extension SYS_ScanMemory_v6_50
                                          1077  #-----------------------------------------------------------------------
                                          1078
                                          1079  # SYS function for searching bytes in memory.
                                          1080  # This function examines bytes starting from address sysArgs[01] and
                                          1081  # stops when encountering a byte equal to either sysArgs[2] or
                                          1082  # sysArgs[3], or when vACL bytes have been examined, whichever comes
                                          1083  # first.  It does not cross page boudaries but wraps around in the
                                          1084  # page, leaving sysArgs[1] unchanged.
                                          1085  #
                                          1086  # Inputs:
                                          1087  #   sysArgs[01]        Start address of the string
                                          1088  #   sysArgs[23]        Bytes to search
                                          1089  #   vACL               Length of the string (0 means 256)
                                          1090  #
                                          1091  # If a matching byte is found, its address is returned in vAC and sysArgs[01].
                                          1092  # Otherwise, zero is returned in vAC and sysArgs[0] point right after the string.
                                          1093
                                          1094  label('SYS_ScanMemory_v6_50')
SYS_ScanMemory_v6_50:
              00e6 1412  ld   $12,y       1095  ld(hi('sys_ScanMemory'),Y)      #15 slot 0xe6
              00e7 e09a  jmp  y,$9a       1096  jmp(Y,'sys_ScanMemory')         #16
              00e8 1525  ld   [$25],y     1097  ld([sysArgs+1],Y)               #17
                                          1098
                                          1099
