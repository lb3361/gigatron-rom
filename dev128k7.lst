                                          2951  # Interrupt handler:
                                          2952  #       ... IRQ payload ...
                                          2953  #       LDWI $400
                                          2954  #       LUP  $xx  ==> vRTI
              04e4 0200  nop              2955  fillers(until=251-16)
              04e5 0200  nop
              04e6 0200  nop
              * 7 times
