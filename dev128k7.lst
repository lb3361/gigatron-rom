                                          6768  # Ensure labels defined here do not conflict
                                          6769  def fsmLab(n):
                                          6770      return f'fsm15:{n}'
                                          6771
                                          6772  # Assemble u-opcode
                                          6773  def fsmAsm(op,arg=None):
                                          6774      bra(fsmLab(op))
                                          6775      ld(pc()+1) if arg is None else ld(arg)
