                                          854   #-----------------------------------------------------------------------
                                          855   # Extension SYS_Divide_s16_v6_80: 15 bit division
                                          856   # Also known as SYS_Divide_u16_v7_34
                                          857   #-----------------------------------------------------------------------
                                          858   #
                                          859   # Computes the Euclidean division of 0<=A<65536 and 0<B<65536.
                                          860   # The s16 component of the name is a misnomer (should be u15).
                                          861   # For 16 bits signed division, additional code must handle the signs
                                          862   # Return the quotient in vAC as well as sysArgs[01]
                                          863   # Return the remainder in sysArgs[45]
                                          864   #
                                          865   #       sysArgs[0:1]    Dividend A (in) Quotient (out)
                                          866   #       sysArgs[2:3]    Divisor B (in)
                                          867   #       sysArgs[4:5]    Remainder (out)
                                          868   #       sysArgs[6:7]    (changed)
                                          869   #
                                          870   # Original design by at67.
                                          871   #
                                          872   # The improced dev7rom version handles unrestricted 16 bits unsigned division
                                          873   # that is 0 <= A,B <= 65535. An external wrapper is still needed for signed
                                          874   # division. Alternatively any of the new opcodes RDIVU or RDIVS.
                                          875
                                          876   label('SYS_Divide_s16_v6_80')
                                          877   label('SYS_Divide_u16_v7_34')
SYS_Divide_s16_v6_80:
SYS_Divide_u16_v7_34:
              00a1 1413  ld   $13,y       878   ld(hi('sys_Divide_u16'),Y)      #15 slot 0xa1
              00a2 e0f0  jmp  y,$f0       879   jmp(Y,'sys_Divide_u16')         #16
              00a3 0200  nop              880   nop()
