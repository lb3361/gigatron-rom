                                          831   # Extension SYS_Multiply_s16_v6_66: 16 bit multiplication
                                          832   # Also known as SYS_Multiply_s16_v7_34.
                                          833   #-----------------------------------------------------------------------
                                          834   #
                                          835   # Computes C = C + A * B where A,B,C are 16 bits integers.
                                          836   # Returns product in vAC as well
                                          837   #
                                          838   #       sysArgs[0:1]    Multiplicand A (in)
                                          839   #       sysArgs[2:3]    Multiplicand B (in)
                                          840   #       sysArgs[4:5]    C (inout)
                                          841   #       sysArgs[6:7]    (changed)
                                          842   #
                                          843   # Original design: at67
                                          844   #
                                          845   # The improved dev7rom version is substantially faster.
                                          846   # Alternatively use the new opcode MULW.
                                          847
                                          848   label('SYS_Multiply_s16_v6_66')
                                          849   label('SYS_Multiply_s16_v7_34')
SYS_Multiply_s16_v6_66:
SYS_Multiply_s16_v7_34:
              009e 1413  ld   $13,y       850   ld(hi('sys_Multiply_s16'),Y)    #15 slot 0x9e
              009f e0e6  jmp  y,$e6       851   jmp(Y,'sys_Multiply_s16')       #16
              00a0 0200  nop              852   nop()
