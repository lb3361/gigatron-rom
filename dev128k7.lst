                                          2986  assert(pc()&255 == 251)         # The landing offset 251 for LUP trampoline is fixed
              04fb 0130  ld   [$30]       2987  ld([vIrqSave+0])                #17
              04fc c216  st   [$16]       2988  st([vPC])                       #18
