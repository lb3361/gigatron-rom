                                          1450  if not WITH_512K_BOARD:
vbSample#49:  0196 0103  ld   [$03]       1451      ld([sample])                #49
              0197 400f  ora  $0f         1452      ora(ledBits)                #50 New sound sample is ready
              0198 2114  anda [$14]       1453      anda([xoutMask])            #51
              0199 c213  st   [$13]       1454      st([xout])                  #52
