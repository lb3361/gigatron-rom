                                          3948
                                          3949  # -------------------------------------------------------------
                                          3950  # vCPU instructions for comparisons between two 16-bit operands
                                          3951  # -------------------------------------------------------------
                                          3952  #
                                          3953  # vCPU's conditional branching (BCC) always compares vAC against 0,
                                          3954  # treating vAC as a two's complement 16-bit number. When we need to
                                          3955  # compare two arbitrary numnbers we normally first take their difference
                                          3956  # with SUBW.  However, when this difference is too large, the subtraction
                                          3957  # overflows and we get the wrong outcome. To get it right over the
                                          3958  # entire range, an elaborate sequence is needed. TinyBASIC uses this
                                          3959  # blurp for its relational operators. (It compares stack variable $02
                                          3960  # with zero page variable $3a.)
                                          3961  #
                                          3962  #       0461  ee 02            LDLW  $02
                                          3963  #       0463  fc 3a            XORW  $3a
                                          3964  #       0465  35 53 6a         BGE   $046c
                                          3965  #       0468  ee 02            LDLW  $02
                                          3966  #       046a  90 6e            BRA   $0470
                                          3967  #       046c  ee 02            LDLW  $02
                                          3968  #       046e  b8 3a            SUBW  $3a
                                          3969  #       0470  35 56 73         BLE   $0475
                                          3970  #
                                          3971  # The CMPHS and CMPHU instructions were introduced to simplify this.
                                          3972  # They inspect both operands to see if there is an overflow risk. If
                                          3973  # so, they modify vAC such that their difference gets smaller, while
                                          3974  # preserving the relation between the two operands. After that, the
                                          3975  # SUBW instruction can't overflow and we achieve a correct comparison.
                                          3976  # Use CMPHS for signed comparisons and CMPHU for unsigned. With these,
                                          3977  # the sequence above becomes:
                                          3978  #
                                          3979  #       0461  ee 02            LDLW  $02
                                          3980  #       0463  1f 3b            CMPHS $3b        Note: high byte of operand
                                          3981  #       0465  b8 3a            SUBW  $3a
                                          3982  #       0467  35 56 73         BLE   $0475
                                          3983  #
                                          3984  # CMPHS/CMPHU don't make much sense other than in combination with
                                          3985  # SUBW. These modify vACH, if needed, as given in the following table:
                                          3986  #
                                          3987  #       vACH  varH  |     vACH
                                          3988  #       bit7  bit7  | CMPHS  CMPHU
                                          3989  #       ---------------------------
                                          3990  #         0     0   |  vACH   vACH      no change needed
                                          3991  #         0     1   | varH+1 varH-1     narrowing the range
                                          3992  #         1     0   | varH-1 varH+1     narrowing the range
                                          3993  #         1     1   |  vACH   vACH      no change needed
                                          3994  #       ---------------------------
                                          3995
                                          3996
                                          3997  # CMPHS implementation (vCPU instruction)
                                          3998  label('cmphs#13')
cmphs#13:     0bdd 0119  ld   [$19]       3999  ld([vAC+1])                     #13
              0bde 6500  xora [x]         4000  xora([X])                       #14
              0bdf f4f5  bge  cmphu#17    4001  bpl('cmphu#17')                 #15
              0be0 1403  ld   $03,y       4002  ld(hi('NEXTY'),Y)               #16
              0be1 0500  ld   [x]         4003  ld([X])                         #17
              0be2 e8e5  blt  $0be5       4004  bmi(pc()+3)                     #18
              0be3 fce6  bra  $0be6       4005  bra(pc()+3)                     #19
              0be4 a001  suba $01         4006  suba(1)                         #20
              0be5 8001  adda $01         4007  adda(1)                         #20
              0be6 c219  st   [$19]       4008  st([vAC+1])                     #21
              0be7 e0cb  jmp  y,$cb       4009  jmp(Y,'REENTER')                #22
              0be8 00f3  ld   $f3         4010  ld(-26/2)                       #23
                                          4011
                                          4012  # CMPHU implementation (vCPU instruction)
                                          4013  label('cmphu#13')
cmphu#13:     0be9 0119  ld   [$19]       4014  ld([vAC+1])                     #13
              0bea 6500  xora [x]         4015  xora([X])                       #14
              0beb f4f5  bge  cmphu#17    4016  bpl('cmphu#17')                 #15
              0bec 1403  ld   $03,y       4017  ld(hi('NEXTY'),Y)               #16
              0bed 0500  ld   [x]         4018  ld([X])                         #17
              0bee e8f1  blt  $0bf1       4019  bmi(pc()+3)                     #18
              0bef fcf2  bra  $0bf2       4020  bra(pc()+3)                     #19
              0bf0 8001  adda $01         4021  adda(1)                         #20
              0bf1 a001  suba $01         4022  suba(1)                         #20
              0bf2 c219  st   [$19]       4023  st([vAC+1])                     #21
              0bf3 e0cb  jmp  y,$cb       4024  jmp(Y,'REENTER')                #22
              0bf4 00f3  ld   $f3         4025  ld(-26/2)                       #23
