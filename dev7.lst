                                          1026  #-----------------------------------------------------------------------
                                          1027  # Extension SYS_DoubleDabble_v7_34
                                          1028  #-----------------------------------------------------------------------
                                          1029
                                          1030  # SYS function to help converting integers into ascii in any base.
                                          1031  # The string of bytes [sysArgs[2:3]...sysArgs[0:1]-1] represents
                                          1032  # a number in base sysArgs[4]. Calling the SYS function doubles
                                          1033  # this number and adds 1 if vAC<=0 (msb set). If necessary
                                          1034  # sysArgs[2:3] is decremented to make space for a new digit.
                                          1035  #
                                          1036  # sysArgs[0:1]       (in)    End address
                                          1037  # sysArgs[2:3]       (inout) Start address
                                          1038  # sysArgs[4]         (in)    Base
                                          1039  # vAC                (in)    Carry in high bit
                                          1040  # sysArgs[5]         (used)
                                          1041
                                          1042  label('SYS_DoubleDabble_v7_34')
SYS_DoubleDabble_v7_34:
              00e0 1420  ld   $20,y       1043  ld(hi('sys_DoubleDabble'),Y)    #15 slot 0xe0
              00e1 e051  jmp  y,$51       1044  jmp(Y,'sys_DoubleDabble')       #16
              00e2 0119  ld   [$19]       1045  ld([vAC+1])                     #17
