                                          2818  #-----------------------------------------------------------------------
                                          2819  #
                                          2820  #  vCPU extension functions (for acceleration and compaction) follow below.
                                          2821  #
                                          2822  #  The naming convention is: SYS_<CamelCase>[_v<V>]_<N>
                                          2823  #
                                          2824  #  With <N> the maximum number of cycles the function will run
                                          2825  #  (counted from NEXT to NEXT). This is the same number that must
                                          2826  #  be passed to the 'SYS' vCPU instruction as operand, and it will
                                          2827  #  appear in the GCL code upon use.
                                          2828  #
                                          2829  #  If a SYS extension got introduced after ROM v1, the version number of
                                          2830  #  introduction is included in the name. This helps the programmer to be
                                          2831  #  reminded to verify the acutal ROM version and fail gracefully on older
                                          2832  #  ROMs than required. See also Docs/GT1-files.txt on using [romType].
                                          2833  #
                                          2834  #-----------------------------------------------------------------------
                                          2835
              04a4 0200  nop              2836  fillers(until=0xa7)
              04a5 0200  nop
              04a6 0200  nop
