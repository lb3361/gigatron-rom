                                          2856    adda([Y,entropy2])            #21
                                          2857    st([Y,entropy2])              #22
                                          2858  else:
              04ad 8108  adda [$08]       2859    adda([entropy+2])             #21
              04ae c208  st   [$08]       2860    st([entropy+2])               #22
              04af e8b2  blt  .sysRnd0    2861  bmi('.sysRnd0')                 #23
              04b0 fcb3  bra  .sysRnd1    2862  bra('.sysRnd1')                 #24
              04b1 6053  xora $53         2863  xora(64+16+2+1)                 #25
