              00ec 1413  ld   $13,y       1136  ld(hi('sys_CopyMemoryExt'),Y)    # 15 slot 0xec
              00ed e078  jmp  y,$78       1137  jmp(Y, 'sys_CopyMemoryExt')      # 16
              00ee 0119  ld   [$19]       1138  ld([vAC+1])                      # 17
