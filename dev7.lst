                                          1600
                                          1601
                                          1602  if WITH_512K_BOARD:
                                          1603
                                          1604    # Code for the Gigatron 512K
                                          1605
                                          1606    fillers(until=0xff)
                                          1607    label('vVisibEnter')
                                          1608    assert(vVisibEnterCyc == 200)
                                          1609    ld(syncBits,OUT)                #200,0 <New scan line start>
                                          1610    align(0x100, size=0x100)
                                          1611
                                          1612    # Front porch
                                          1613    anda([channelMask])             #1 AC is [channel] already!
                                          1614    adda(1)                         #2
                                          1615    st([channel],Y)                 #3
                                          1616    ld(syncBits^hSync,OUT)          #4 Start horizontal pulse (4)
                                          1617    ld(0x7f)                        #5 Sound processing
                                          1618    anda([Y,oscL])                  #6
                                          1619    adda([Y,keyL])                  #7
                                          1620    st([Y,oscL])                    #8
                                          1621    anda(0x80,X)                    #9
                                          1622    ld([X])                         #10
                                          1623    adda([Y,oscH])                  #11
                                          1624    adda([Y,keyH])                  #12
                                          1625    st([Y,oscH] )                   #13
                                          1626    anda(0xfc)                      #14
                                          1627    xora([Y,wavX])                  #15
                                          1628    ld(AC,X)                        #16
                                          1629    ld([Y,wavA])                    #17
                                          1630    ld(soundTable>>8,Y)             #18
                                          1631    adda([Y,X])                     #19
                                          1632    bmi(pc()+3)                     #20
                                          1633    bra(pc()+3)                     #21
                                          1634    anda(63)                        #22
                                          1635    ld(63)                          #22(!)
                                          1636    adda([sample])                  #23
                                          1637    st([sample])                    #24
                                          1638    ld([xout])                      #25 Gets copied to XOUT
                                          1639    ld(videoTable>>8,Y)             #26 Make Y=1 for all videoABC routines!
                                          1640    bra([nextVideo])                #27
                                          1641    ld(syncBits,OUT)                #28 End horizontal pulse
                                          1642
                                          1643    # Back porch A: first of 4 repeated scan lines
                                          1644    # - Fetch next Yi and store it for retrieval in the next scan lines
                                          1645    # - Calculate Xi from dXi and store it as well thanks to a saved cycle.
                                          1646    label('videoA')
                                          1647    ld('videoB')                    #29 1st scanline of 4 (always visible)
                                          1648    st([nextVideo])                 #30
                                          1649    ld([videoY],X)                  #31
                                          1650    ld([Y,X])                       #32 Y is already 1
                                          1651    st([Y,Xpp])                     #33 Just X++
                                          1652    st([frameY])                    #34
                                          1653    ld([Y,X])                       #35
                                          1654    adda([frameX])                  #36
                                          1655    st([frameX],X)                  #37 I am sure Marcel sought to do this (LB)
                                          1656    ld([frameY],Y)                  #38
                                          1657    ld(syncBits)                    #39
                                          1658    ora([Y,Xpp],OUT)                #40 begin of pixel burst
                                          1659    runVcpu_new(vVisibEnterCyc-41,  #41
                                          1660            'A--- line 40-520' )
                                          1661
                                          1662    # Back porch B: second of 4 repeated scan lines
                                          1663    # - Process double vres
                                          1664    label('videoB')
                                          1665    ld('videoC')                    #29
                                          1666    st([nextVideo])                 #30
                                          1667    ld([frameY],Y)                  #31
                                          1668    ld([videoModeC])                #32 New role for videoModeC
                                          1669    anda(1)                         #33
                                          1670    adda([frameY])                  #34
                                          1671    st([frameY])                    #35
                                          1672    ld([frameX],X)                  #36
                                          1673    ld(syncBits)                    #37
                                          1674    bra([videoModeB])               #38
                                          1675    bra(pc()+2)                     #39
                                          1676    nop()                           #40 'pixels' or 'nopixels'
                                          1677    runVcpu_new(vVisibEnterCyc-41,  #41
                                          1678            '-B-- line 40-520' )
                                          1679
                                          1680    # Back porch C: third of 4 repeated scan lines
                                          1681    # - Nothing new to for video do as Yi and Xi are known,
                                          1682    # - This is the time to emit and reset the next sound sample
                                          1683    label('videoC')
                                          1684    ld('videoD')                    #29 3rd scanline of 4
                                          1685    st([nextVideo])                 #30
                                          1686    ld([sample])                    #31 New sound sample is ready (didn't fit in audio loop)
                                          1687    ora(ledBits)                    #32
                                          1688    anda([xoutMask])                #33
                                          1689    st([xout])                      #34 Update [xout] with new sample (4 channels just updated)
                                          1690    ld([frameX],X)                  #35
                                          1691    ld([xoutMask])                  #36
                                          1692    bmi('videoC#39')                #37
                                          1693    ld([frameY],Y)                  #38
                                          1694    ld(syncBits)                    #39
                                          1695    ora([Y,Xpp], OUT)               #40 Always outputs pixels on C lines
                                          1696    runVcpu_new(vVisibEnterCyc-41,  #41
                                          1697            '--C- line 40-520 no sound')
                                          1698
                                          1699    label('videoC#39')
                                          1700    ld(syncBits)                    #39
                                          1701    ora([Y,Xpp], OUT)               #40 Always outputs pixels on C lines
                                          1702    ld([sample],Y)                  #41
                                          1703    st(sample, [sample])            #42 Reset for next sample
                                          1704    ctrl(Y,0xD0);                   #43 Forward audio to PWM (only when audio is active)
                                          1705    runVcpu_new(vVisibEnterCyc-44,  #44
                                          1706            '--C- line 40-520 sound forwarding')
                                          1707
                                          1708    # Back porch D: last of 4 repeated scan lines
                                          1709    # - Calculate the next frame index
                                          1710    # - Decide if this is the last line or not
                                          1711    label('videoD')                 # Default video mode
                                          1712    ld([frameX], X)                 #29 4th scanline of 4
                                          1713    ld([videoY])                    #30
                                          1714    suba((120-1)*2)                 #31
                                          1715    beq('.lastpixels#34')           #32
                                          1716    adda(120*2)                     #33 More pixel lines to go
                                          1717    st([videoY])                    #34
                                          1718    nop()                           #35
                                          1719    ld([frameY],Y)                  #36
                                          1720    ld(syncBits)                    #37
                                          1721    bra([videoModeD])               #38
                                          1722    bra(pc()+2)                     #39
                                          1723    nop()                           #40 'pixels' or 'nopixels'
                                          1724    nop()                           #41
                                          1725    ld('videoA')                    #42
                                          1726    label('videoD#43')
                                          1727    st([nextVideo])                 #43
                                          1728    runVcpu_new(vVisibEnterCyc-44,  #44
                                          1729            '---D line 40-520')
                                          1730
                                          1731    label('.lastpixels#34')
                                          1732    if soundDiscontinuity == 1:
                                          1733      st(sample, [sample])          #34 Sound continuity
                                          1734    else:
                                          1735      nop()                         #34
                                          1736    ld([frameY],Y)                  #35
                                          1737    ld(syncBits)                    #36
                                          1738    nop()                           #37
                                          1739    bra([videoModeD])               #38
                                          1740    bra(pc()+2)                     #39
                                          1741    nop()                           #40 'pixels' or 'nopixels'
                                          1742    bra('videoD#43')                #41
                                          1743    ld('videoE')                    #42 no more scanlines
                                          1744
                                          1745    # Back porch "E": after the last line
                                          1746    # - Go back and and enter vertical blank (program page 2)
                                          1747    label('videoE') # Exit visible area
                                          1748    ld(hi('vBlankStart'),Y)         #29 Return to vertical blank interval
                                          1749    jmp(Y,'vBlankStart')            #30
                                          1750    ld(syncBits)                    #31
                                          1751
                                          1752    # Video mode that blacks out one or more pixel lines from the top of screen.
                                          1753    # This yields some speed, but also frees up screen memory for other purposes.
                                          1754    # Note: Sound output becomes choppier the more pixel lines are skipped
                                          1755    # Note: The vertical blank driver leaves 0x80 behind in [videoSync1]
                                          1756    label('videoF')
                                          1757    ld([videoSync1])                #29 Completely black pixel line
                                          1758    adda(0x80)                      #30
                                          1759    st([videoSync1],X)              #31
                                          1760    ld([frameX])                    #32
                                          1761    suba([X])                       #33 Decrements every two VGA scanlines
                                          1762    beq('.videoF#36')               #34
                                          1763    st([frameX])                    #35
                                          1764    bra('.videoF#38')               #36
                                          1765    label('.videoF#36')
                                          1766    ld('videoA')                    #36,37 Transfer to visible screen area
                                          1767    st([nextVideo])                 #37
                                          1768    label('.videoF#38')
                                          1769    runVcpu_new(200-38,             #38
                                          1770            'F--- line 40-520')
                                          1771
                                          1772    fillers(until=0xfc);
                                          1773    label('pixels')
                                          1774    ora([Y,Xpp],OUT)                #40
                                          1775    label('nopixels')
                                          1776    nop()                           #40
                                          1777
                                          1778  else:
                                          1779
                                          1780    # Code for the Gigatron / Gigatron 128K
                                          1781
                                          1782    if WITH_128K_BOARD:
                                          1783      fillers(until=0xe3)
                                          1784      label('vVisibEnter')          # Return from vCPU interpreter
                                          1785      assert(vVisibEnterCyc == 200)
                                          1786      ld([ctrlVideo],X)             #200,0 <New scan line start>
                                          1787      ctrl(X)                       #1 Reset banking to page1.
                                          1788      anda([channelMask])           #2 AC contains [channel]
                                          1789      adda(1)                       #3
                                          1790      ld(syncBits^hSync,OUT)        #4 Start horizontal pulse
                                          1791      st([channel],Y)               #5
                                          1792      ld(0x7f)                      #6  Copying the sound code
                                          1793      anda([Y,oscL])                #7  prevents losing one precious
                                          1794      adda([Y,keyL])                #8  cycle in a branch to sound3
                                          1795      st([Y,oscL])                  #9
                                          1796      anda(0x80,X)                  #10
                                          1797      ld([X])                       #11
                                          1798      adda([Y,oscH])                #12
                                          1799      adda([Y,keyH])                #13
                                          1800      st([Y,oscH] )                 #14
                                          1801      anda(0xfc)                    #15
                                          1802      xora([Y,wavX])                #16
                                          1803      ld(AC,X)                      #17
                                          1804      ld([Y,wavA])                  #18
                                          1805      ld(soundTable>>8,Y)           #19
                                          1806      adda([Y,X])                   #20
                                          1807      bmi(pc()+3)                   #21
                                          1808      bra(pc()+3)                   #22
                                          1809      anda(63)                      #23
                                          1810      ld(63)                        #23
                                          1811      adda([sample])                #24
                                          1812      st([sample])                  #25
                                          1813      ld([xout])                    #26
                                          1814      assert(pc()&0xff == 0xff)
                                          1815      bra([nextVideo])              #27
                                          1816      align(0x100, size=0x100)
                                          1817      ld(syncBits,OUT)              #28 End horizontal pulse
                                          1818
                                          1819
                                          1820    else:
              01d8 0200  nop              1821      fillers(until=0xff)
              01d9 0200  nop
              01da 0200  nop
              * 39 times
                                          1822      label('vVisibEnter')          # Return from vCPU interpreter
                                          1823      assert(vVisibEnterCyc == 200)
vVisibEnter:  01ff fcae  bra  sound3      1824      bra('sound3')                 #200,0 <New scan line start>
                                          1825      align(0x100, size=0x100)
              0200 0102  ld   [$02]       1826      ld([channel])                 #1 AC already contains [channel]
                                          1827
                                          1828    # Back porch A: first of 4 repeated scan lines
                                          1829    # - Fetch next Yi and store it for retrieval in the next scan lines
                                          1830    # - Calculate Xi from dXi, but there is no cycle time left to store it as well
                                          1831    label('videoA')
videoA:       0201 00ca  ld   $ca         1832    ld('videoB')                    #29 1st scanline of 4 (always visible)
              0202 c20d  st   [$0d]       1833    st([nextVideo])                 #30
              0203 1401  ld   $01,y       1834    ld(videoTable>>8,Y)             #31
              0204 1109  ld   [$09],x     1835    ld([videoY],X)                  #32
              0205 0d00  ld   [y,x]       1836    ld([Y,X])                       #33
              0206 de00  st   [y,x++]     1837    st([Y,Xpp])                     #34 Just X++
              0207 c220  st   [$20]       1838    st([frameY])                    #35
              0208 0d00  ld   [y,x]       1839    ld([Y,X])                       #36
              0209 911f  adda [$1f],x     1840    adda([frameX],X)                #37
                                          1841    label('pixels')
pixels:       020a 1520  ld   [$20],y     1842    ld([frameY],Y)                  #38
              020b 00c0  ld   $c0         1843    ld(syncBits)                    #39
                                          1844
                                          1845    # Stream 160 pixels from memory location <Yi,Xi> onwards
                                          1846    # Superimpose the sync signal bits to be robust against misprogramming
                                          1847    for i in range(qqVgaWidth):
              020c 5d00  ora  [y,x++],out 1848      ora([Y,Xpp],OUT)              #40-199 Pixel burst
              020d 5d00  ora  [y,x++],out
              020e 5d00  ora  [y,x++],out
              * 160 times
              02ac 18c0  ld   $c0,out     1849    ld(syncBits,OUT)                #0 <New scan line start> Back to black
                                          1850
                                          1851    # Front porch
              02ad 0102  ld   [$02]       1852    ld([channel])                   #1 Advance to next sound channel
                                          1853    label('sound3')                 #  Return from vCPU interpreter (except 128k)
sound3:       02ae 2121  anda [$21]       1854    anda([channelMask])             #2
              02af 8001  adda $01         1855    adda(1)                         #3
              02b0 1880  ld   $80,out     1856    ld(syncBits^hSync,OUT)          #4 Start horizontal pulse
              02b1 d602  st   [$02],y     1857    st([channel],Y)                 #5 Sound processing
              02b2 007f  ld   $7f         1858    ld(0x7f)                        #6
              02b3 29fe  anda [y,$fe]     1859    anda([Y,oscL])                  #7
              02b4 89fc  adda [y,$fc]     1860    adda([Y,keyL])                  #8
              02b5 cafe  st   [y,$fe]     1861    st([Y,oscL])                    #9
              02b6 3080  anda $80,x       1862    anda(0x80,X)                    #10
              02b7 0500  ld   [x]         1863    ld([X])                         #11
              02b8 89ff  adda [y,$ff]     1864    adda([Y,oscH])                  #12
              02b9 89fd  adda [y,$fd]     1865    adda([Y,keyH])                  #13
              02ba caff  st   [y,$ff]     1866    st([Y,oscH] )                   #14
              02bb 20fc  anda $fc         1867    anda(0xfc)                      #15
              02bc 69fb  xora [y,$fb]     1868    xora([Y,wavX])                  #16
              02bd 1200  ld   ac,x        1869    ld(AC,X)                        #17
              02be 09fa  ld   [y,$fa]     1870    ld([Y,wavA])                    #18
              02bf 1407  ld   $07,y       1871    ld(soundTable>>8,Y)             #19
              02c0 8d00  adda [y,x]       1872    adda([Y,X])                     #20
              02c1 e8c4  blt  $02c4       1873    bmi(pc()+3)                     #21
              02c2 fcc5  bra  $02c5       1874    bra(pc()+3)                     #22
              02c3 203f  anda $3f         1875    anda(63)                        #23
              02c4 003f  ld   $3f         1876    ld(63)                          #23
              02c5 8103  adda [$03]       1877    adda([sample])                  #24
              02c6 c203  st   [$03]       1878    st([sample])                    #25
                                          1879
              02c7 0113  ld   [$13]       1880    ld([xout])                      #26 Gets copied to XOUT
              02c8 fd0d  bra  [$0d]       1881    bra([nextVideo])                #27
              02c9 18c0  ld   $c0,out     1882    ld(syncBits,OUT)                #28 End horizontal pulse
                                          1883
                                          1884    # Back porch B: second of 4 repeated scan lines
                                          1885    # - Recompute Xi from dXi and store for retrieval in the next scan lines
                                          1886    label('videoB')
videoB:       02ca 00d3  ld   $d3         1887    ld('videoC')                    #29 2nd scanline of 4
              02cb c20d  st   [$0d]       1888    st([nextVideo])                 #30
              02cc 1401  ld   $01,y       1889    ld(videoTable>>8,Y)             #31
              02cd 0109  ld   [$09]       1890    ld([videoY])                    #32
              02ce 9001  adda $01,x       1891    adda(1,X)                       #33
              02cf 011f  ld   [$1f]       1892    ld([frameX])                    #34
              02d0 8d00  adda [y,x]       1893    adda([Y,X])                     #35
              02d1 fd0a  bra  [$0a]       1894    bra([videoModeB])               #36
              02d2 d21f  st   [$1f],x     1895    st([frameX],X)                  #37 Store in RAM and X
                                          1896
                                          1897    # Back porch C: third of 4 repeated scan lines
                                          1898    # - Nothing new to for video do as Yi and Xi are known,
                                          1899    # - This is the time to emit and reset the next sound sample
                                          1900    label('videoC')
videoC:       02d3 00dc  ld   $dc         1901    ld('videoD')                    #29 3rd scanline of 4
              02d4 c20d  st   [$0d]       1902    st([nextVideo])                 #30
              02d5 0103  ld   [$03]       1903    ld([sample])                    #31 New sound sample is ready (didn't fit in audio loop)
              02d6 400f  ora  $0f         1904    ora(ledBits)                    #32 0x0f
              02d7 2114  anda [$14]       1905    anda([xoutMask])                #33
              02d8 c213  st   [$13]       1906    st([xout])                      #34 Update [xout] with new sample (4 channels just updated)
              02d9 c003  st   $03,[$03]   1907    st(sample, [sample])            #35 Reset for next sample
              02da fd0b  bra  [$0b]       1908    bra([videoModeC])               #36
              02db 111f  ld   [$1f],x     1909    ld([frameX],X)                  #37
                                          1910
                                          1911    # Back porch D: last of 4 repeated scan lines
                                          1912    # - Calculate the next frame index
                                          1913    # - Decide if this is the last line or not
                                          1914    label('videoD')                 # Default video mode
videoD:       02dc 111f  ld   [$1f],x     1915    ld([frameX], X)                 #29 4th scanline of 4
              02dd 0109  ld   [$09]       1916    ld([videoY])                    #30
              02de a0ee  suba $ee         1917    suba((120-1)*2)                 #31
                                          1918    beq('.lastpixels#34')           #32
              02df f0e5  beq  .lastpixels#34
              02e0 80f0  adda $f0         1919    adda(120*2)                     #33 More pixel lines to go
              02e1 c209  st   [$09]       1920    st([videoY])                    #34
              02e2 0001  ld   $01         1921    ld('videoA')                    #35
              02e3 fd0c  bra  [$0c]       1922    bra([videoModeD])               #36
              02e4 c20d  st   [$0d]       1923    st([nextVideo])                 #37
                                          1924
                                          1925    label('.lastpixels#34')
                                          1926    if soundDiscontinuity == 1:
.lastpixels#34:
              02e5 c003  st   $03,[$03]   1927      st(sample, [sample])          #34 Sound continuity
                                          1928    else:
                                          1929      nop()                         #34
              02e6 00e9  ld   $e9         1930    ld('videoE')                    #35 No more pixel lines to go
              02e7 fd0c  bra  [$0c]       1931    bra([videoModeD])               #36
              02e8 c20d  st   [$0d]       1932    st([nextVideo])                 #37
                                          1933
                                          1934    # Back porch "E": after the last line
                                          1935    # - Go back and and enter vertical blank (program page 2)
                                          1936    label('videoE') # Exit visible area
videoE:       02e9 1401  ld   $01,y       1937    ld(hi('vBlankStart'),Y)         #29 Return to vertical blank interval
              02ea e004  jmp  y,$04       1938    jmp(Y,'vBlankStart')            #30
              02eb 00c0  ld   $c0         1939    ld(syncBits)                    #31
                                          1940
                                          1941    # Video mode that blacks out one or more pixel lines from the top of screen.
                                          1942    # This yields some speed, but also frees up screen memory for other purposes.
                                          1943    # Note: Sound output becomes choppier the more pixel lines are skipped
                                          1944    # Note: The vertical blank driver leaves 0x80 behind in [videoSync1]
                                          1945    label('videoF')
videoF:       02ec 0120  ld   [$20]       1946    ld([videoSync1])                #29 Completely black pixel line
              02ed 8080  adda $80         1947    adda(0x80)                      #30
              02ee d220  st   [$20],x     1948    st([videoSync1],X)              #31
              02ef 011f  ld   [$1f]       1949    ld([frameX])                    #32
              02f0 a500  suba [x]         1950    suba([X])                       #33 Decrements every two VGA scanlines
              02f1 f0f4  beq  .videoF#36  1951    beq('.videoF#36')               #34
              02f2 c21f  st   [$1f]       1952    st([frameX])                    #35
              02f3 fcf6  bra  nopixels    1953    bra('nopixels')                 #36
                                          1954    label('.videoF#36')
.videoF#36:   02f4 0001  ld   $01         1955    ld('videoA')                    #36,37 Transfer to visible screen area
              02f5 c20d  st   [$0d]       1956    st([nextVideo])                 #37
                                          1957    #
                                          1958    # Alternative for pixel burst: faster application mode
                                          1959    label('nopixels')
                                          1960    if WITH_128K_BOARD:
                                          1961      ld([ctrlCopy],X)                #38
                                          1962      ctrl(X)                         #39
                                          1963      runVcpu_new(vVisibEnterCyc-40,  #40
                                          1964              'FBCD line 40-520')     # Application interpreter (black scanlines)
                                          1965    else:
nopixels:     02f6 1505  ld   [$05],y     1966      runVcpu_new(vVisibEnterCyc-38,  #38
              02f7 e0ff  jmp  y,$ff
              02f8 003c  ld   $3c
                                          1967              'FBCD line 40-520')     # Application interpreter (black scanlines)
                                          1968
                                          1969
                                          1970
                                          1971  #-----------------------------------------------------------------------
                                          1972  #
                                          1973  #  $0300 ROM page 3: Application interpreter primary page
                                          1974  #
                                          1975  #-----------------------------------------------------------------------
                                          1976
                                          1977  # Enter the timing-aware application interpreter (aka virtual CPU, vCPU)
                                          1978  #
                                          1979  # This routine will execute as many as possible instructions in the
                                          1980  # allotted time. When time runs out, it synchronizes such that the total
                                          1981  # duration matches the caller's request. Durations are counted in `ticks',
                                          1982  # which are multiples of 2 clock cycles.
                                          1983  #
                                          1984  # Synopsis: Use the runVcpu() macro as entry point
                                          1985
                                          1986  # We let 'ENTER' begin one word before the page boundary, for a bit extra
                                          1987  # precious space in the packed interpreter code page. Although ENTER's
                                          1988  # first instruction is bra() which normally doesn't cross page boundaries,
                                          1989  # in this case it will still jump into the right space, because branches
                                          1990  # from $xxFF land in the next page anyway.
                                          1991
              02f9 0200  nop              1992  fillers(until=0xff)
              02fa 0200  nop
              02fb 0200  nop
              * 6 times
                                          1993  label('ENTER')
ENTER:        02ff fc03  bra  .next2      1994  bra('.next2')                   #0 Enter at '.next2' (so no startup overhead)
                                          1995  # --- Page boundary ---
                                          1996  align(0x100,size=0x100)
                                          1997  label('NEXTY')                  # Alternative for REENTER
NEXTY:        0300 1517  ld   [$17],y     1998  ld([vPC+1],Y)                   #1
                                          1999
                                          2000  # Fetch next instruction and execute it, but only if there are sufficient
                                          2001  # ticks left for the slowest instruction.
                                          2002  label('NEXT')
NEXT:         0301 8115  adda [$15]       2003  adda([vTicks])                  #0 Track elapsed ticks (actually counting down: AC<0)
              0302 e80b  blt  EXIT        2004  blt('EXIT')                     #1 Escape near time out
                                          2005  label('.next2')
.next2:       0303 c215  st   [$15]       2006  st([vTicks])                    #2
              0304 0116  ld   [$16]       2007  ld([vPC])                       #3 Advance vPC
              0305 8002  adda $02         2008  adda(2)                         #4
              0306 d216  st   [$16],x     2009  st([vPC],X)                     #5
              0307 0d00  ld   [y,x]       2010  ld([Y,X])                       #6 Fetch opcode (actually a branch target)
              0308 de00  st   [y,x++]     2011  st([Y,Xpp])                     #7 Just X++
              0309 fe00  bra  ac          2012  bra(AC)                         #8 Dispatch
              030a 0d00  ld   [y,x]       2013  ld([Y,X])                       #9 Prefetch operand
                                          2014
                                          2015  # Resync with video driver and transfer control
                                          2016  label('EXIT')
EXIT:         030b 800f  adda $0f         2017  adda(maxTicks)                  #3
                                          2018  label('RESYNC')
RESYNC:       030c e40c  bgt  RESYNC      2019  bgt(pc()&255)                   #4 Resync
              030d a001  suba $01         2020  suba(1)                         #5
              030e 1401  ld   $01,y       2021  ld(hi('vBlankStart'),Y)         #6
              030f e11e  jmp  y,[$1e]     2022  jmp(Y,[vReturn])                #7 To video driver
              0310 0102  ld   [$02]       2023  ld([channel])                   #8 with channel in AC
                                          2024  assert vCPU_overhead ==          9
                                          2025
                                          2026  # Instruction LDWI: Load immediate word constant (vAC=D), 20 cycles
                                          2027  label('LDWI')
LDWI:         0311 c218  st   [$18]       2028  st([vAC])                       #10
              0312 de00  st   [y,x++]     2029  st([Y,Xpp])                     #11 Just X++
              0313 0116  ld   [$16]       2030  ld([vPC])                       #12 Advance vPC one more
              0314 8001  adda $01         2031  adda(1)                         #13
              0315 c216  st   [$16]       2032  st([vPC])                       #14
              0316 fc28  bra  ldw#17      2033  bra('ldw#17')                   #15
              0317 0d00  ld   [y,x]       2034  ld([Y,X])                       #16 Fetch second operand
                                          2035
                                          2036  # Instruction NEGV (18 vv) [26 cycles]
                                          2037  # * Negates word [vv]:=-[vv]
                                          2038  label('NEGV_v7')
NEGV_v7:      0318 141f  ld   $1f,y       2039  ld(hi('negv#13'),Y)             #10
              0319 e0e3  jmp  y,$e3       2040  jmp(Y,'negv#13')                #11+overlap
                                          2041
                                          2042  # Instruction LD: Load byte from zero page (vAC=[D]), 18 cycles
                                          2043  label('LD')
LD:           031a 1200  ld   ac,x        2044  ld(AC,X)                        #10
              031b fcc1  bra  ld#13       2045  bra('ld#13')                    #11
              031c 0500  ld   [x]         2046  ld([X])                         #13
                                          2047
                                          2048  # Helper for INC.
                                          2049  label('inc#14')
inc#14:       031d fcc4  bra  ld#16       2050  bra('ld#16')                    #14
              031e c600  st   [x]         2051  st([X])                         #15
                                          2052
                                          2053  # Instruction CMPHS: Adjust high byte for signed compare (vACH=XXX), 20-26 cycles
                                          2054  label('CMPHS_v5')
CMPHS_v5:     031f 140b  ld   $0b,y       2055  ld(hi('cmphs#13'),Y)            #10
              0320 e0dd  jmp  y,$dd       2056  jmp(Y,'cmphs#13')               #11
                                          2057  #ld(AC,X)                       #12 Overlap
                                          2058  #
                                          2059  # Instruction LDW: Load word from zero page (vAC=[D]+256*[D+1]), 20 cycles
                                          2060  label('LDW')
LDW:          0321 1200  ld   ac,x        2061  ld(AC,X)                        #10,12
              0322 8001  adda $01         2062  adda(1)                         #11
              0323 c22f  st   [$2f]       2063  st([vTmp])                      #12 Address of high byte
              0324 0500  ld   [x]         2064  ld([X])                         #13
              0325 112f  ld   [$2f],x     2065  ld([vTmp],X)                    #14
              0326 c218  st   [$18]       2066  st([vAC])                       #15
              0327 0500  ld   [x]         2067  ld([X])                         #16
                                          2068  label('ldw#17')
ldw#17:       0328 c219  st   [$19]       2069  st([vAC+1])                     #17
              0329 fc01  bra  NEXT        2070  bra('NEXT')                     #18
              032a 00f6  ld   $f6         2071  ld(-20/2)                       #19
                                          2072
                                          2073  # Instruction STW: Store word in zero page ([D],[D+1]=vAC&255,vAC>>8), 20 cycles
                                          2074  label('STW')
STW:          032b 1200  ld   ac,x        2075  ld(AC,X)                        #10
              032c 1400  ld   $00,y       2076  ld(0,Y)                         #11
              032d 0118  ld   [$18]       2077  ld([vAC])                       #12
              032e de00  st   [y,x++]     2078  st([Y,Xpp])                     #13
              032f 0119  ld   [$19]       2079  ld([vAC+1])                     #14
              0330 ce00  st   [y,x]       2080  st([Y,X])                       #15
              0331 fccb  bra  REENTER     2081  bra('REENTER')                  #16
              0332 00f6  ld   $f6         2082  ld(-20/2)                       #17
                                          2083
                                          2084  # Instruction ADDHI (33 xx), 16 cycles
                                          2085  # * Add constant xx to vACH.
                                          2086  # * To be used in conjunction with ADDI add a 16 bits constant
                                          2087  label('ADDHI_v7')
ADDHI_v7:     0333 fc5b  bra  ldi#12      2088  bra('ldi#12')
              0334 8119  adda [$19]       2089  adda([vAC+1])
                                          2090
                                          2091  # Instruction PREFIX35: (used to be BCC)
                                          2092  label('BCC')
                                          2093  label('PREFIX35')
BCC:
PREFIX35:     0335 de00  st   [y,x++]     2094  st([Y,Xpp])                     #10
              0336 1417  ld   $17,y       2095  ld(hi('PREFIX35_PAGE'),Y)       #11
              0337 e200  jmp  y,ac        2096  jmp(Y,AC)                       #12
              0338 1517  ld   [$17],y     2097  ld([vPC+1],Y)                   #13
                                          2098
                                          2099  # Instruction POKEA (39 xx), 22 cycles
                                          2100  # * Store word [xx] at location [vAC]
                                          2101  # * Origin: https://forum.gigatron.io/viewtopic.php?p=2053#p2053
                                          2102  #   Section 2. "POKE and DOKE work backwards"
                                          2103  label('POKEA_v7')
POKEA_v7:     0339 1419  ld   $19,y       2104  ld(hi('pokea#13'),Y)            #10,12
              033a e009  jmp  y,$09       2105  jmp(Y,'pokea#13')               #11
                                          2106
                                          2107  # Instruction DOKEA (3b xx), 28 cycles
                                          2108  # * Store word [xx] at location [vAC]
                                          2109  # * Origin: https://forum.gigatron.io/viewtopic.php?p=2053#p2053
                                          2110  #   Section 2. "POKE and DOKE work backwards"
                                          2111  label('DOKEA_v7')
DOKEA_v7:     033b 1419  ld   $19,y       2112  ld(hi('dokea#13'),Y)            #10
              033c e011  jmp  y,$11       2113  jmp(Y,'dokea#13')               #11+overlap
                                          2114
                                          2115  # Instruction DEEKA (3d xx), 30 cycles
                                          2116  # * Load word at location [vAC] and store into [xx]
                                          2117  # * Trashes sysArgs7 but can DEEK(sysArgs6or7)
                                          2118  # * Origin: https://forum.gigatron.io/viewtopic.php?p=2053#p2053
                                          2119  #   Section 2. "POKE and DOKE work backwards"
                                          2120  label('DEEKA_v7')
DEEKA_v7:     033d 1419  ld   $19,y       2121  ld(hi('deeka#13'),Y)            #10,12
              033e e01f  jmp  y,$1f       2122  jmp(Y,'deeka#13')               #11
                                          2123
                                          2124  # Instruction JEQ (3f ll hh), 24/26 cycles (was EQ)
                                          2125  # * Branch if zero (if(vACL==0)vPC=hhll[+2])
                                          2126  # * Original idea from at67
                                          2127  label('EQ')
                                          2128  label('JEQ_v7')
EQ:
JEQ_v7:       033f 1419  ld   $19,y       2129  ld(hi('jeq#13'),Y)              #10,12
              0340 e0d6  jmp  y,$d6       2130  jmp(Y,'jeq#13')                 #11
                                          2131
                                          2132  # Instruction DEEKV (41 vv), 28 cycles
                                          2133  # * shortcut for LDW(vv);DEEK()
                                          2134  # * Original idea from at67
                                          2135  label('DEEKV_v7')
DEEKV_v7:     0341 1419  ld   $19,y       2136  ld(hi('deekv#13'),Y)            #10,12
              0342 e04b  jmp  y,$4b       2137  jmp(Y,'deekv#13')               #11
              0343 c22f  st   [$2f]       2138  st([vTmp])                      #12
                                          2139
                                          2140  # Instruction DOKEQ (44 ii), 22 cycles
                                          2141  # * Store immediate ii into word pointed by vAC
                                          2142  label('DOKEQ_v7')
DOKEQ_v7:     0344 1419  ld   $19,y       2143  ld(hi('dokeq#13'),Y)            #10,12
              0345 e035  jmp  y,$35       2144  jmp(Y,'dokeq#13')               #11
                                          2145
                                          2146  # Instruction POKEQ (46 ii), 20 cycles
                                          2147  # * Store immediate ii into byte pointed by vAC
                                          2148  label('POKEQ_v7')
POKEQ_v7:     0346 1419  ld   $19,y       2149  ld(hi('pokeq#13'),Y)            #10,12
              0347 e02f  jmp  y,$2f       2150  jmp(Y,'pokeq#13')               #11
                                          2151
                                          2152  # Instruction MOVQB (48 vv ii), 26 cycles
                                          2153  # * Store immediate ii into byte [vv]:=ii
                                          2154  label('MOVQB_v7')
MOVQB_v7:     0348 1420  ld   $20,y       2155  ld(hi('movqb#13'),Y)            #10
              0349 e090  jmp  y,$90       2156  jmp(Y,'movqb#13')               #11
                                          2157
                                          2158  # Instruction MOVQW (4a vv ii), 28 cycles
                                          2159  # * Store immediate ii into word [vv]:=ii [vv+1]:=0
                                          2160  label('MOVQW_v7')
MOVQW_v7:     034a 1420  ld   $20,y       2161  ld(hi('movqw#13'),Y)            #10
              034b e09c  jmp  y,$9c       2162  jmp(Y,'movqw#13')               #11
              034c 1517  ld   [$17],y     2163  ld([vPC+1],Y)                   #12
                                          2164
                                          2165  # Instruction JGT (4d ll hh), 22-24/26 cycles (was GT)
                                          2166  # * Branch if positive (if(vACL>0)vPC=hhll[+2])
                                          2167  # * Original idea from at67
                                          2168  label('GT')
                                          2169  label('JGT_v7')
GT:
JGT_v7:       034d 1419  ld   $19,y       2170  ld(hi('jgt#13'),Y)              #10,12
              034e e0e0  jmp  y,$e0       2171  jmp(Y,'jgt#13')                 #11
              034f 0119  ld   [$19]       2172  ld([vAC+1])                     #12
                                          2173
                                          2174  # Instruction JLT (50 ll hh), 22/24 cycles (was LT)
                                          2175  # * Branch if negative (if(vACL<0)vPC=hhll[+2])
                                          2176  # * Original idea from at67
                                          2177  label('LT')
                                          2178  label('JLT_v7')
LT:
JLT_v7:       0350 1419  ld   $19,y       2179  ld(hi('jlt#13'),Y)              #10
              0351 e0f2  jmp  y,$f2       2180  jmp(Y,'jlt#13')                 #11
              0352 0119  ld   [$19]       2181  ld([vAC+1])                     #12
                                          2182
                                          2183  # Instruction JGE (53 ll hh), 22/24 cycles (was GE)
                                          2184  # * Branch if positive or zero (if(vACL>=0)vPC=hhll[+2])
                                          2185  # * Original idea from at67
                                          2186  label('GE')
                                          2187  label('JGE_v7')
GE:
JGE_v7:       0353 1419  ld   $19,y       2188  ld(hi('jge#13'),Y)              #10
              0354 e0e8  jmp  y,$e8       2189  jmp(Y,'jge#13')                 #11
              0355 0119  ld   [$19]       2190  ld([vAC+1])                     #12
                                          2191
                                          2192  # Instruction JLE (56 ll hh), 22-24/26 cycles (was LE)
                                          2193  # * Branch if negative or zero (if(vACL<=0)vPC=hhll[+2])
                                          2194  # * Original idea from at67
                                          2195  label('JLE_v7')
JLE_v7:       0356 1419  ld   $19,y       2196  ld(hi('jle#13'),Y)              #10
              0357 e0fa  jmp  y,$fa       2197  jmp(Y,'jle#13')                 #11
              0358 0119  ld   [$19]       2198  ld([vAC+1])                     #12
                                          2199
                                          2200  # Instruction LDI: Load immediate small positive constant (vAC=D), 16 cycles
                                          2201  label('LDI')
LDI:          0359 c218  st   [$18]       2202  st([vAC])                       #10
              035a 0000  ld   $00         2203  ld(0)                           #11
                                          2204  label('ldi#12')
ldi#12:       035b c219  st   [$19]       2205  st([vAC+1])                     #12
              035c fc00  bra  NEXTY       2206  bra('NEXTY')                    #13
              035d 00f8  ld   $f8         2207  ld(-16/2)                       #14
                                          2208
                                          2209  # Instruction ST: Store byte in zero page ([D]=vAC&255), 16 cycles
                                          2210  label('ST')
ST:           035e 1200  ld   ac,x        2211  ld(AC,X)                        #10,15
