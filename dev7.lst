                                          3455
                                          3456  #-----------------------------------------------------------------------
                                          3457  # Extension SYS_SetMode_v2_80
                                          3458  #-----------------------------------------------------------------------
                                          3459
                                          3460  # Set video mode to 0 to 3 black scanlines per pixel line.
                                          3461  #
                                          3462  # Mainly for making the MODE command available in Tiny BASIC, so that
                                          3463  # the user can experiment. It's adviced to refrain from using
                                          3464  # SYS_SetMode_v2_80 in regular applications. Video mode is a deeply
                                          3465  # personal preference, and the programmer shouldn't overrule the user
                                          3466  # in that choice. The Gigatron philisophy is that the end user has
                                          3467  # the final say on what happens on the system, not the application,
                                          3468  # even if that implies a degraded performance. This doesn't mean that
                                          3469  # all applications must work well in all video modes: mode 1 is still
                                          3470  # the default. If an application really doesn't work at all in that
                                          3471  # mode, it's acceptable to change mode once after loading.
                                          3472  #
                                          3473  # There's no "SYS_GetMode" function.
                                          3474  #
                                          3475  # Variables:
                                          3476  #       vAC bit 0:1     Mode:
                                          3477  #                         0      "ABCD" -> Full mode (slowest)
                                          3478  #                         1      "ABC-" -> Default mode after reset
                                          3479  #                         2      "A-C-" -> at67's mode
                                          3480  #                         3      "A---" -> HGM's mode
                                          3481  #       vAC bit 2:15    Ignored bits and should be 0
                                          3482  #
                                          3483  # Special values (ROM v4):
                                          3484  #       vAC = 1975      Zombie mode (no video signals, no input,
                                          3485  #                        no blinkenlights).
                                          3486  #       vAC = -1        Leave zombie mode and restore previous mode.
                                          3487
                                          3488  # Actual duration is <80 cycles, but keep some room for future extensions
                                          3489  label('SYS_SetMode_v2_80')
SYS_SetMode_v2_80:
              0b00 140b  ld   $0b,y       3490  ld(hi('sys_SetMode'),Y)         #15
              0b01 e05d  jmp  y,$5d       3491  jmp(Y,'sys_SetMode')            #16
              0b02 011e  ld   [$1e]       3492  ld([vReturn])                   #17
                                          3493
                                          3494  #-----------------------------------------------------------------------
                                          3495  # Extension SYS_SetMemory_v2_54
                                          3496  #-----------------------------------------------------------------------
                                          3497
                                          3498  # SYS function for setting 1..256 bytes
                                          3499  #
                                          3500  # sysArgs[0]   Copy count (in, changed)
                                          3501  # sysArgs[1]   Copy value (in)
                                          3502  # sysArgs[2:3] Destination address (in, changed)
                                          3503  #
                                          3504  # Sets up to 8 bytes per invocation before restarting itself through vCPU.
                                          3505  # Doesn't wrap around page boundary. Can run 3 times per 148-cycle time slice.
                                          3506  # All combined that gives a 300% speedup over ROMv4 and before.
                                          3507
                                          3508  label('SYS_SetMemory_v2_54')
SYS_SetMemory_v2_54:
              0b03 0124  ld   [$24]       3509  ld([sysArgs+0])                 #15
                                          3510  bra('sys_SetMemory#18')         #16
              0b04 fc1a  bra  sys_SetMemory#18
              0b05 1126  ld   [$26],x     3511  ld([sysArgs+2],X)               #17
                                          3512
                                          3513  #-----------------------------------------------------------------------
                                          3514  # Extension SYS_SendSerial1_v3_80
                                          3515  #-----------------------------------------------------------------------
                                          3516
                                          3517  # SYS function for sending data over serial controller port using
                                          3518  # pulse width modulation of the vertical sync signal.
                                          3519  #
                                          3520  # Variables:
                                          3521  #       sysArgs[0:1]    Source address               (in, changed)
                                          3522  #       sysArgs[2]      Start bit mask (typically 1) (in, changed)
                                          3523  #       sysArgs[3]      Number of send frames X      (in, changed)
                                          3524  #
                                          3525  # The sending will abort if input data is detected on the serial port.
                                          3526  # Returns 0 in case of all bits sent, or <>0 in case of abort
                                          3527  #
                                          3528  # This modulates the next upcoming X vertical pulses with the supplied
                                          3529  # data. A zero becomes a 7 line vPulse, a one will be 9 lines.
                                          3530  # After that, the vPulse width falls back to 8 lines (idle).
                                          3531
                                          3532  label('SYS_SendSerial1_v3_80')
SYS_SendSerial1_v3_80:
              0b06 0109  ld   [$09]       3533  ld([videoY])                    #15
                                          3534  bra('sys_SendSerial1')          #16
              0b07 fc8c  bra  sys_SendSerial1
              0b08 60b3  xora $b3         3535  xora(videoYline0)               #17 First line of vertical blank
                                          3536
                                          3537  #-----------------------------------------------------------------------
                                          3538  # Extension SYS_ExpanderControl_v4_40
                                          3539  #-----------------------------------------------------------------------
                                          3540
                                          3541  # Sets the I/O and RAM expander's control register
                                          3542  #
                                          3543  # Variables:
                                          3544  #       vAC bit 2       Device enable /SS0
                                          3545  #           bit 3       Device enable /SS1
                                          3546  #           bit 4       Device enable /SS2
                                          3547  #           bit 5       Device enable /SS3
                                          3548  #           bit 6       Banking B0
                                          3549  #           bit 7       Banking B1
                                          3550  #           bit 15      Data out MOSI
                                          3551  #       sysArgs[7]      Cache for control state (written to)
                                          3552  #
                                          3553  # Intended for prototyping, and probably too low-level for most applications
                                          3554  # Still there's a safeguard: it's not possible to disable RAM using this
                                          3555
                                          3556  label('SYS_ExpanderControl_v4_40')
SYS_ExpanderControl_v4_40:
              0b09 140d  ld   $0d,y       3557  ld(hi('sys_ExpanderControl'),Y) #15
              0b0a e000  jmp  y,$00       3558  jmp(Y,'sys_ExpanderControl')    #16
              0b0b 000c  ld   $0c         3559  ld(0b00001100)                  #17
                                          3560  #    ^^^^^^^^
                                          3561  #    |||||||`-- SCLK
                                          3562  #    ||||||`--- Not connected
                                          3563  #    |||||`---- /SS0
                                          3564  #    ||||`----- /SS1
                                          3565  #    |||`------ /SS2 or /CPOL
                                          3566  #    ||`------- /SS3 or /ZPBANK
                                          3567  #    |`-------- B0
                                          3568  #    `--------- B1
                                          3569
                                          3570  #-----------------------------------------------------------------------
                                          3571  # Extension SYS_Run6502_v4_80
                                          3572  #-----------------------------------------------------------------------
                                          3573
                                          3574  # Transfer control to v6502
                                          3575  #
                                          3576  # Calling 6502 code from vCPU goes (only) through this SYS function.
                                          3577  # Directly modifying the vCpuSelect variable is unreliable. The
                                          3578  # control transfer is immediate, without waiting for the current
                                          3579  # time slice to end or first returning to vCPU.
                                          3580  #
                                          3581  # vCPU code and v6502 code can interoperate without much hassle:
                                          3582  # - The v6502 program counter is vLR, and v6502 doesn't touch vPC
                                          3583  # - Returning to vCPU is with the BRK instruction
                                          3584  # - BRK doesn't dump process state on the stack
                                          3585  # - vCPU can save/restore the vLR with PUSH/POP
                                          3586  # - Stacks are shared, vAC is shared
                                          3587  # - vAC can indicate what the v6502 code wants. vAC+1 will be cleared
                                          3588  # - Alternative is to leave a word in sysArgs[6:7] (v6502 X and Y registers)
                                          3589  # - Another way is to set vPC before BRK, and vCPU will continue there(+2)
                                          3590  #
                                          3591  # Calling v6502 code from vCPU looks like this:
                                          3592  #       LDWI  SYS_Run6502_v4_80
                                          3593  #       STW   sysFn
                                          3594  #       LDWI  $6502_start_address
                                          3595  #       STW   vLR
                                          3596  #       SYS   80
                                          3597  #
                                          3598  # Variables:
                                          3599  #       vAC             Accumulator
                                          3600  #       vLR             Program Counter
                                          3601  #       vSP             Stack Pointer (+1)
                                          3602  #       sysArgs[6]      Index Register X
                                          3603  #       sysArgs[7]      Index Register Y
                                          3604  # For info:
                                          3605  #       sysArgs[0:1]    Address Register, free to clobber
                                          3606  #       sysArgs[2]      Instruction Register, free to clobber
                                          3607  #       sysArgs[3:5]    Flags, don't touch
                                          3608  #
                                          3609  # Implementation details::
                                          3610  #
                                          3611  #  The time to reserve for this transition is the maximum time
                                          3612  #  between NEXT and v6502_check. This is
                                          3613  #       SYS call duration + 2*v6502_maxTicks + (v6502_overhead - vCPU_overhead)
                                          3614  #     = 22 + 28 + (11 - 9) = 62 cycles.
                                          3615  #  So reserving 80 cycles is future proof. This isn't overhead, as it includes
                                          3616  #  the fetching of the first 6502 opcode and its operands..
                                          3617  #
                                          3618  #                      0            10                 28=0         9
                                          3619  #    ---+----+---------+------------+------------------+-----------+---
                                          3620  # video | nop| runVcpu |   ENTER    | At least one ins |   EXIT    | video
                                          3621  #    ---+----+---------+------------+------------------+-----------+---
                                          3622  #        sync  prelude  ENTER-to-ins    ins-to-NEXT     NEXT-to-video
                                          3623  #       |<-->|
                                          3624  #        0/1 |<------->|
                                          3625  #                 5    |<----------------------------->|
                                          3626  #          runVCpu_overhead           28               |<--------->|
                                          3627  #                                 2*maxTicks                 9
                                          3628  #                                                      vCPU_overhead
                                          3629  #
                                          3630  #                      0                21                    38=0       11
                                          3631  #    ---+----+---------+----------------+--------------------+-----------+---
                                          3632  # video | nop| runVcpu |   v6502_ENTER  | At least one fetch |v6502_exitB| video
                                          3633  #    ---+----+---------+----------------+--------------------+-----------+---
                                          3634  #        sync  prelude   enter-to-fetch     fetch-to-check    check-to-video
                                          3635  #       |<-->|
                                          3636  #        0/1 |<------->|
                                          3637  #                 5    |<----------------------------------->|
                                          3638  #          runVcpu_overhead           38                     |<--------->|
                                          3639  #                              2*v6520_maxTicks                    11
                                          3640  #                                                            v6502_overhead
                                          3641
                                          3642  label('SYS_Run6502_v4_80')
SYS_Run6502_v4_80:
              0b0c 140d  ld   $0d,y       3643  ld(hi('sys_v6502'),Y)           #15
              0b0d e08b  jmp  y,$8b       3644  jmp(Y,'sys_v6502')              #16
              0b0e 000d  ld   $0d         3645  ld(hi('v6502_ENTER'))           #17 Activate v6502
