                                          1477  #
                                          1478  # This is executed during the last video blanking line.
                                          1479  # It sets up things for the visible lines that follow
                                          1480
                                          1481  label('.vBlankLast#32')
.vBlankLast#32:
              0198 e028  jmp  y,$28       1482  jmp(Y,'vBlankLast#34')          #32 Jump out of page for space reasons
              0199 1401  ld   $01,y       1483  ld(hi(pc()),Y)                  #33
                                          1484
                                          1485  label('vBlankLast#52')
                                          1486
                                          1487  # Respond to reset button (14 cycles)
                                          1488  # - ResetTimer decrements as long as just [Start] is pressed down
                                          1489  # - Reaching 0 (normal) or 128 (extended) triggers the soft reset sequence
                                          1490  # - Initial value is 128 (or 255 at boot), first decrement, then check
                                          1491  # - This starts vReset -> SYS_Reset_88 -> SYS_Exec_88 -> Reset.gcl -> Main.gcl
                                          1492  # - Main.gcl then recognizes extended presses if resetTimer is 0..127 ("paasei")
                                          1493  # - This requires a full cycle (4s) in the warm boot scenario
                                          1494  # - Or a half cycle (2s) when pressing [Select] down during hard reset
                                          1495  # - This furthermore requires >=1 frame (and <=128) to have passed between
                                          1496  #   reaching 128 and getting through Reset and the start of Main, while [Start]
                                          1497  #   was still pressed so the count reaches <128. Two reasonable expectations.
                                          1498  # - The unintended power-up scenarios of ROMv1 (pulling SER_DATA low, or
                                          1499  #   pressing [Select] together with another button) now don't trigger anymore.
                                          1500
vBlankLast#52:
              019a 0111  ld   [$11]       1501  ld([buttonState])               #52 Check [Start] for soft reset
              019b 60ef  xora $ef         1502  xora(~buttonStart)              #53
              019c eca5  bne  .restart#56 1503  bne('.restart#56')              #54
              019d 0112  ld   [$12]       1504  ld([resetTimer])                #55 As long as button pressed
              019e a001  suba $01         1505  suba(1)                         #56 ... count down the timer
              019f c212  st   [$12]       1506  st([resetTimer])                #57
              01a0 207f  anda $7f         1507  anda(127)                       #58
              01a1 f0ad  beq  .restart#61 1508  beq('.restart#61')              #59 Reset at 0 (normal 2s) or 128 (extended 4s)
              01a2 00ee  ld   $ee         1509  ld((vReset&255)-2)              #60 Start force reset when hitting 0
              01a3 fcac  bra  .restart#63 1510  bra('.restart#63')              #61 ... otherwise do nothing yet
              01a4 fcab  bra  .restart#64 1511  bra('.restart#64')              #62
                                          1512  label('.restart#56')
.restart#56:  01a5 0001  ld   $01         1513  wait(62-56)                     #56
              01a6 eca6  bne  $01a6
              01a7 a001  suba $01
              01a8 0200  nop
              01a9 0080  ld   $80         1514  ld(128)                         #62 Not pressed, reset the timer
              01aa c212  st   [$12]       1515  st([resetTimer])                #63
                                          1516  label('.restart#64')
.restart#64:  01ab fcb2  bra  .restart#66 1517  bra('.restart#66')              #64
                                          1518  label('.restart#63')
.restart#63:  01ac 0200  nop              1519  nop()                           #63,65
                                          1520  label('.restart#61')
.restart#61:  01ad c216  st   [$16]       1521  st([vPC])                       #61 Point vPC at vReset
              01ae 0001  ld   $01         1522  ld(vReset>>8)                   #62
              01af c217  st   [$17]       1523  st([vPC+1])                     #63
              01b0 0002  ld   $02         1524  ld(hi('ENTER'))                 #64 Set active interpreter to vCPU
              01b1 c205  st   [$05]       1525  st([vCpuSelect])                #65
                                          1526  label('.restart#66')
