                                          7166  #bra('NEXT')                     #6
                                          7167  #ld(-8/2)                        #7
                                          7168
                                          7169  # Usage fsmAsm('BL', arg)
                                          7170  # - branch and link using sysArgs+6 as link register
                                          7171  # - call subroutine with fsmAsm('BL', 'label')
                                          7172  # - return from subroutine with fsmAsm('BL',[sysArgs+6])
                                          7173  label(fsmLab('BL'))
fsm16:B:
fsm16:BL:     161d 1415  ld   $15,y       7174  ld(hi('fsmBL#8'),Y)             #5
              161e e0be  jmp  y,$be       7175  jmp(Y,'fsmBL#8')                #6
              161f c22f  st   [$2f]       7176  st([vTmp])                      #7
                                          7177
                                          7178  # Usage: fsmAsm('VRETNZ')
                                          7179  # - if vLR is nonzero, return to vCPU at address vLR.
                                          7180  label(fsmLab('VRETNZ'))
fsm16:VRETNZ: 1620 1415  ld   $15,y       7181  ld(hi('fsmVRETNZ#8'),Y)         #5
