                                          3380  #
                                          3381  #  $0700 ROM page 7-8: Gigatron font data
                                          3382  #
                                          3383  #-----------------------------------------------------------------------
                                          3384
              06e6 0200  nop              3385  align(0x100, size=0x100)
              06e7 0200  nop
