                                          10899  # Context structure
                                          10900  #
                                          10901  # page+0xe0: vAC
                                          10902  #     +0xe2: vPC, vLR, vSP
                                          10903  #     +0xe8: vLAC, vT2, vT3
                                          10904  #     +0xf0: sysArgs[0-7]
                                          10905  #     +0xf8: sysFn
                                          10906  #     +0xfa: vFAS, vFAE, vLAX0
                                          10907  #     +0xfd: vCpuSelect
                                          10908  #     +0xfe: irqFlag
                                          10909  #     +0xff: irqMask
                                          10910
                                          10911  def vSave(off,*vars):
                                          10912      for v in vars:
                                          10913          ld([v])
                                          10914          st([Y,off])
                                          10915          off += 1
                                          10916
                                          10917  def vRest(off,*vars):
                                          10918      for v in vars:
                                          10919          ld([Y,off])
                                          10920          st([v])
                                          10921          off += 1
