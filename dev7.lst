                                          3304  # Extension SYS_Unpack_56
                                          3305  #-----------------------------------------------------------------------
                                          3306
                                          3307  # Unpack 3 bytes into 4 pixels
                                          3308  #
                                          3309  # Variables:
                                          3310  #       sysArgs[0:2]    Packed bytes (in)
                                          3311  #       sysArgs[0:3]    Pixels (out)
                                          3312
                                          3313  fillers(until = 0xc0)
                                          3314  assert pc() == 0x6c0
                                          3315  label('SYS_Unpack_56')
SYS_Unpack_56:
              06c0 1420  ld   $20,y       3316  ld(hi('unpack#18'),Y)           #15
              06c1 e022  jmp  y,$22       3317  jmp(Y,'unpack#18')              #16
              06c2 0115  ld   [$15]       3318  ld([vTicks])                    #17
