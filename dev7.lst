notesTable:   0900 0000  ld   $00         3419  ld(0)
              0901 0000  ld   $00         3420  ld(0)
                                          3421  for i in range(0, 250, 2):
                                          3422    j = i//2-1
                                          3423    freq = 440.0*2.0**((j-57)/12.0)
                                          3424    if j>=0 and freq <= sampleRate/2.0:
                                          3425      key = int(round(32768 * freq / sampleRate))
                                          3426      octave, note = j//12, notes[j%12]
                                          3427      sharp = '-' if notes[j%12-1] != note else '#'
                                          3428      comment = '%s%s%s (%0.1f Hz)' % (note, sharp, octave, freq)
                                          3429      ld(key&127); C(comment); ld(key>>7)
