SUBI:         03e6 1420  ld   $20,y       2531  ld(hi('subi#13'),Y)             #10
              03e7 e0aa  jmp  y,$aa       2532  jmp(Y,'subi#13')                #11
              03e8 c22f  st   [$2f]       2533  st([vTmp])                      #12
