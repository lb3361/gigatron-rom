                                          3691  #-----------------------------------------------------------------------
                                          3692  # Extension SYS_ReceiveSerial1_v6_32
                                          3693  #-----------------------------------------------------------------------
                                          3694
                                          3695  # SYS function for receiving one byte over the serial controller port.
                                          3696  # This is a public version of SYS_NextByteIn from the loader private
                                          3697  # extension.  A byte is read from IN when videoY reaches
                                          3698  # sysArgs[3]. The byte is added to the checksum sysArgs[2] then stored
                                          3699  # at address sysArgs[0:1] which gets incremented.
                                          3700  #
                                          3701  # The 65 bytes of a serial frame can be read for the following values
                                          3702  # of videoY: 207 (protocol byte) 219 (length, 6 bits only) 235, 251
                                          3703  # (address) then 2, 6, 10, .. 238 stepping by four, then 185.
                                          3704  #
                                          3705  # Variables:
                                          3706  #     sysArgs[0:1] Address
                                          3707  #     sysArgs[2]   Checksum
                                          3708  #     sysArgs[3]   Wait value (videoY)
                                          3709
                                          3710  label('SYS_ReceiveSerial1_v6_32')
SYS_ReceiveSerial1_v6_32:                 3711  bra('sys_ReceiveSerial1')       #15
              0b18 fcbe  bra  sys_ReceiveSerial1
              0b19 0127  ld   [$27]       3712  ld([sysArgs+3])                 #16
