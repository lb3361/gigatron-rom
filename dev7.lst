.select#83:   01c6 010b  ld   [$0b]       1555    ld([videoModeC])              #83
              01c7 e8cd  blt  .select#86  1556    bmi('.select#86')             #84 Branch when line C is off
              01c8 010a  ld   [$0a]       1557    ld([videoModeB])              #85 Rotate: Off->D->B->C
              01c9 c20b  st   [$0b]       1558    st([videoModeC])              #86
