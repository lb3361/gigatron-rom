                                          217   enableListing()
                                          218   #-----------------------------------------------------------------------
                                          219   #
                                          220   #  Start of core
                                          221   #
                                          222   #-----------------------------------------------------------------------
                                          223
                                          224   # Pre-loading the formal interface as a way to get warnings when
                                          225   # accidentally redefined with a different value
                                          226   loadBindings('interface.json')
                                          227   loadBindings('Core/interface-dev.json') # Provisional values for DEVROM
                                          228
                                          229   # Gigatron clock
                                          230   cpuClock = 6.250e+06
                                          231
                                          232   # Output pin assignment for VGA
                                          233   R, G, B, hSync, vSync = 1, 4, 16, 64, 128
                                          234   syncBits = hSync+vSync # Both pulses negative
                                          235
                                          236   # When the XOUT register is in the circuit, the rising edge triggers its update.
                                          237   # The loop can therefore not be agnostic to the horizontal pulse polarity.
                                          238   assert syncBits & hSync != 0
                                          239
                                          240   # VGA 640x480 defaults (to be adjusted below!)
                                          241   vFront = 10     # Vertical front porch
                                          242   vPulse = 2      # Vertical sync pulse
                                          243   vBack  = 33     # Vertical back porch
                                          244   vgaLines = vFront + vPulse + vBack + 480
                                          245   vgaClock = 25.175e+06
                                          246
                                          247   # Video adjustments for Gigatron
                                          248   # 1. Our clock is (slightly) slower than 1/4th VGA clock. Not all monitors will
                                          249   #    accept the decreased frame rate, so we restore the frame rate to above
                                          250   #    minimum 59.94 Hz by cutting some lines from the vertical front porch.
                                          251   vFrontAdjust = vgaLines - int(4 * cpuClock / vgaClock * vgaLines)
                                          252   vFront -= vFrontAdjust
                                          253   # 2. Extend vertical sync pulse so we can feed the game controller the same
                                          254   #    signal. This is needed for controllers based on the 4021 instead of 74165
                                          255   vPulseExtension = max(0, 8-vPulse)
                                          256   vPulse += vPulseExtension
                                          257   # 3. Borrow these lines from the back porch so the refresh rate remains
                                          258   #    unaffected
                                          259   vBack -= vPulseExtension
                                          260
                                          261   # Start value of vertical blank counter
                                          262   videoYline0 = 1-2*(vFront+vPulse+vBack-2)
                                          263
                                          264   # Mismatch between video lines and sound channels
                                          265   soundDiscontinuity = (vFront+vPulse+vBack) % 4
                                          266
                                          267   # QQVGA resolution
                                          268   qqVgaWidth      = 160
                                          269   qqVgaHeight     = 120
                                          270
                                          271   # Game controller bits (actual controllers in kit have negative output)
                                          272   # +----------------------------------------+
                                          273   # |       Up                        B*     |
                                          274   # |  Left    Right               B     A*  |
                                          275   # |      Down      Select Start     A      |
                                          276   # +----------------------------------------+ *=Auto fire
                                          277   buttonRight     = 1
                                          278   buttonLeft      = 2
                                          279   buttonDown      = 4
                                          280   buttonUp        = 8
                                          281   buttonStart     = 16
                                          282   buttonSelect    = 32
                                          283   buttonB         = 64
                                          284   buttonA         = 128
                                          285
                                          286   #-----------------------------------------------------------------------
                                          287   #
                                          288   #  RAM page 0: zero-page variables
                                          289   #
                                          290   #-----------------------------------------------------------------------
                                          291
                                          292   # Memory size in pages from auto-detect
                                          293   memSize         = zpByte()
                                          294
                                          295   # The current channel number for sound generation. Advanced every scan line
                                          296   # and independent of the vertical refresh to maintain constant oscillation.
                                          297   channel         = zpByte()
                                          298
                                          299   # Next sound sample being synthesized
                                          300   sample          = zpByte()
                                          301   # To save one instruction in the critical inner loop, `sample' is always
                                          302   # reset with its own address instead of, for example, the value 0. Compare:
                                          303   # 1 instruction reset
                                          304   #       st sample,[sample]
                                          305   # 2 instruction reset:
                                          306   #       ld 0
                                          307   #       st [sample]
                                          308   # The difference is not audible. This is fine when the reset/address
                                          309   # value is low and doesn't overflow with 4 channels added to it.
                                          310   # There is an alternative, but it requires pull-down diodes on the data bus:
                                          311   #       st [sample],[sample]
                                          312   assert 4*63 + sample < 256
                                          313   # We pin this reset/address value to 3, so `sample' swings from 3 to 255
                                          314   assert sample == 3
                                          315
                                          316   # Former bootCount and bootCheck (<= ROMv3)
                                          317   zpReserved      = zpByte() # Recycled and still unused. Candidate future uses:
                                          318                              # - Video driver high address (for alternative video modes)
                                          319                              # - v6502: ADH offset ("MMU")
                                          320                              # - v8080: ???
                                          321   vCpuSelect      = zpByte() # Active interpreter page
                                          322
                                          323   if WITH_128K_BOARD:
                                          324     entropy      = zpByte(2) # Entropy harvested from SRAM startup and controller input
                                          325     ctrlVideo    = zpByte()  # ctrl bits for video access
                                          326   else:
                                          327     entropy      = zpByte(3) # Entropy harvested from SRAM startup and controller input
                                          328
                                          329   # Visible video
                                          330   videoY          = zpByte() # Counts up from 0 to 238 in steps of 2
                                          331                              # Counts up (and is odd) during vertical blank
                                          332   videoModeB      = zpByte() # Handler for every 2nd line (pixel burst or vCPU)
                                          333   videoModeC      = zpByte() # Handler for every 3rd line (pixel burst or vCPU)
                                          334   videoModeD      = zpByte() # Handler for every 4th line (pixel burst or vCPU)
                                          335
                                          336   nextVideo       = zpByte() # Jump offset to scan line handler (videoA, B, C...)
                                          337   videoPulse      = nextVideo # Used for pulse width modulation
                                          338
                                          339   # Frame counter is good enough as system clock
                                          340   frameCount      = zpByte(1)
                                          341
                                          342   # Serial input (game controller)
                                          343   serialRaw       = zpByte() # New raw serial read
                                          344   serialLast      = zpByte() # Previous serial read
                                          345   buttonState     = zpByte() # Clearable button state
                                          346   resetTimer      = zpByte() # After 2 seconds of holding 'Start', do a soft reset
                                          347                              # XXX move to page 1 to free up space
                                          348
                                          349   # Extended output (blinkenlights in bit 0:3 and audio in bit 4:7). This
                                          350   # value must be present in AC during a rising hSync edge. It then gets
                                          351   # copied to the XOUT register by the hardware. The XOUT register is only
                                          352   # accessible in this indirect manner because it isn't part of the core
                                          353   # CPU architecture.
                                          354   xout            = zpByte()
                                          355   xoutMask        = zpByte() # The blinkenlights and sound on/off state
                                          356
                                          357   # vCPU interpreter
                                          358   vTicks          = zpByte()  # Interpreter ticks are units of 2 clocks
                                          359   vPC             = zpByte(2) # Interpreter program counter, points into RAM
                                          360   vAC             = zpByte(2) # Interpreter accumulator, 16-bits
                                          361   vLR             = zpByte(2) # Return address, for returning after CALL
                                          362   vSP             = zpByte(2) # Stack pointer (16 bits!)
                                          363   vReturn         = zpByte()  # Return into video loop (in page of vBlankStart)
                                          364
                                          365   # Scratch
                                          366   frameX          = zpByte() # Starting byte within page
                                          367   frameY          = zpByte() # Page of current pixel line (updated by videoA)
                                          368
                                          369   # Vertical blank (reuse some variables used in the visible part)
                                          370   videoSync0      = frameX   # Vertical sync type on current line (0xc0 or 0x40)
                                          371   videoSync1      = frameY   # Same during horizontal pulse (0x80 or 0x00)
                                          372
                                          373   # Versioning for GT1 compatibility
                                          374   # Please refer to Docs/GT1-files.txt for interpreting this variable
                                          375   romType         = zpByte(1)
                                          376
                                          377   # The low 3 bits are repurposed to select the actively updated sound channels.
                                          378   # Valid bit combinations are:
                                          379   #  xxxxx011     Default after reset: 4 channels (page 1,2,3,4)
                                          380   #  xxxxx001     2 channels at double update rate (page 1,2)
                                          381   #  xxxxx000     1 channel at quadruple update rate (page 1)
                                          382   # The main application for this is to free up the high bytes of page 2,3,4.
                                          383   channelMask = symbol('channelMask_v4')
                                          384   assert romType == channelMask
                                          385
                                          386   # SYS function arguments and results/scratch
                                          387   sysFn           = zpByte(2)
                                          388   sysArgs         = zpByte(8)
                                          389   fsmState        = sysArgs+7
                                          390
                                          391   # Play sound if non-zero, count down and stop sound when zero
                                          392   soundTimer      = zpByte()
                                          393
                                          394   # Former ledTimer
                                          395   if WITH_128K_BOARD:
                                          396     ctrlCopy      = zpByte() # ctrl bits for vcpu access
                                          397   else:
                                          398     zpReserved2   = zpByte()
                                          399
                                          400   # LED state machine
                                          401   ledState_v2     = zpByte() # Current LED state
                                          402
                                          403   # Former ledTempo
                                          404   vTmp            = zpByte() # Scratch byte
                                          405
                                          406   # Management of free space in page zero (userVars)
                                          407   # * Programs that only use the features of ROMvx can
                                          408   #   safely use all bytes above userVars_vx except 0x80.
                                          409   # * Programs that use some but not all features of ROMvx
                                          410   #   may exceptionally use bytes between userVars
                                          411   #   and userVars_vx if they avoid using ROM features
                                          412   #   that need them. This is considerably riskier.
                                          413   userVars        = zpByte(0)
                                          414
                                          415   # Start of safely usable bytes under ROMv4
                                          416   userVars_v4     = zpByte(0)
                                          417   vIrqSave        = zpByte(6) # saved vcpu context during virq
                                          418   # Start of safely usable bytes under ROMv5,6,7
                                          419   userVars_v5     = zpByte(0)
                                          420   userVars_v6     = zpByte(0)
                                          421   userVars_v7     = zpByte(0)
                                          422
                                          423   # [0x80] Constant 0x01
                                          424   oneConst        = 0x80
                                          425
                                          426   zpReset(0x81)                 # Second variable zone
                                          427   userVars2       = zpByte(0)
                                          428   userVars2_v4    = zpByte(0)+1 # ROMv4's ctrlBits at 0x81!!!
                                          429   userVars2_v5    = zpByte(0)
                                          430   userVars2_v6    = zpByte(0)
                                          431   vFAS            = zpByte(1)   # FAC sign
                                          432   vFAE            = zpByte(1)   # FAC exponent
                                          433   vLAX            = zpByte(1)   # Extended long accumulator (40 bits)
                                          434   vLAC            = zpByte(4)   # Long accumulator (32 bits)
                                          435   vT2             = zpByte(2)   # T2 register
                                          436   vT3             = zpByte(2)   # T3 register
                                          437   userVars2_v7    = zpByte(0)
                                          438
