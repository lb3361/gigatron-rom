                                          7105  # Ensure labels defined here do not conflict
                                          7106  def fsmLab(n):
                                          7107      return f'fsm16:{n}'
                                          7108
                                          7109  # Assemble u-opcode
                                          7110  def fsmAsm(op,arg=None):
                                          7111      bra(fsmLab(op))
                                          7112      ld(pc()+1) if arg is None else ld(arg)
                                          7113
                                          7114  # Usage fsmAsm('ST', arg)
                                          7115  # - [arg] := vACL
                                          7116  label(fsmLab('ST'))
fsm16:ST:     160a 1415  ld   $15,y       7117  ld(hi('fsmST#8'),Y)             #5
              160b e09f  jmp  y,$9f       7118  jmp(Y,'fsmST#8')                #6 + overlap
                                          7119
                                          7120  # Usage fsmAsm('LD', arg)
                                          7121  # - vACL = arg with arg=d or arg=[d]
                                          7122  label(fsmLab('LD'))
fsm16:LD:     160c 1415  ld   $15,y       7123  ld(hi('fsmOP#8'),Y)             #5
              160d e0a9  jmp  y,$a9       7124  jmp(Y,'fsmOP#8')                #6 + overlap
                                          7125
                                          7126  # Usage fsmAsm('ADD', arg)
                                          7127  # - vACL += arg with arg=d or arg=[d]
                                          7128  label(fsmLab('ADD'))
fsm16:ADD:    160e 1415  ld   $15,y       7129  ld(hi('fsmOP#8'),Y)             #5,7
              160f e0a9  jmp  y,$a9       7130  jmp(Y,'fsmOP#8')                #6
              1610 8118  adda [$18]       7131  adda([vAC])                     #7
                                          7132
                                          7133  # Usage fsmAsm('AND', arg)
                                          7134  # - vACL &= arg with arg=d or arg=[d]
                                          7135  label(fsmLab('AND'))
fsm16:AND:    1611 1415  ld   $15,y       7136  ld(hi('fsmOP#8'),Y)             #5,7
              1612 e0a9  jmp  y,$a9       7137  jmp(Y,'fsmOP#8')                #6
              1613 2118  anda [$18]       7138  anda([vAC])                     #7
                                          7139
                                          7140  # Usage fsmAsm('LSR4')
                                          7141  # - right shift vACL by 4 positions (high nibble)
                                          7142  label(fsmLab('LSR4'))
fsm16:LSR4:   1614 1415  ld   $15,y       7143  ld(hi('fsmLSR4#8'),Y)           #5
              1615 e0ac  jmp  y,$ac       7144  jmp(Y,'fsmLSR4#8')              #6
              1616 c22b  st   [$2b]       7145  st([fsmState])                  #7
                                          7146
                                          7147  # Usage fsmAsm('BNZ', arg)
                                          7148  # - branch if [vACL] is nonzero
                                          7149  label(fsmLab('BNZ'))
fsm16:BNZ:    1617 1415  ld   $15,y       7150  ld(hi('fsmBNZ#8'),Y)            #5,7
              1618 e0b4  jmp  y,$b4       7151  jmp(Y,'fsmBNZ#8')               #6
              1619 c22f  st   [$2f]       7152  st([vTmp])                      #7
                                          7153
                                          7154  # Usage fsmAsm('BZ', arg)
                                          7155  # - branch if [vACL] is zero
                                          7156  label(fsmLab('BZ'))
fsm16:BZ:     161a 1415  ld   $15,y       7157  ld(hi('fsmBZ#8'),Y)             #5
              161b e0b9  jmp  y,$b9       7158  jmp(Y,'fsmBZ#8')                #6
              161c c22f  st   [$2f]       7159  st([vTmp])                      #7
                                          7160
                                          7161  # Usage fsmAsm('B', arg)
                                          7162  # - unconditional branch
                                          7163  # - can be the same as BL if sysArgs+6 can be trashed
                                          7164  label(fsmLab('B'))
