                                          440   #-----------------------------------------------------------------------
                                          441   #
                                          442   #  RAM page 1: video line table
                                          443   #
                                          444   #-----------------------------------------------------------------------
                                          445
                                          446   # Byte 0-239 define the video lines
                                          447   videoTable      = 0x0100 # Indirection table: Y[0] dX[0]  ..., Y[119] dX[119]
                                          448
                                          449   vReset          = 0x01f0 # Reset stub
                                          450   if WITH_128K_BOARD:
                                          451     entropy2      = 0x01f2 # (displaced) Entropy hidden state
                                          452   reserved_1f3    = 0x01f3 # (was ledTempo_v7)
                                          453   reserved_1f4    = 0x01f4 # (was ledTimer_v7)
                                          454   vIrqCtx_v7      = 0x01f5 # context page for irq
                                          455   vIRQ_v5         = 0x01f6 # vIRQ vector
                                          456   ctrlBits        = 0x01f8 # Expansion control bits
                                          457   videoTop_v5     = 0x01f9 # Number of skipped lines
                                          458
                                          459   # Highest bytes are for sound channel variables
                                          460   wavA = 250      # Waveform modulation with `adda'
                                          461   wavX = 251      # Waveform modulation with `xora'
                                          462   keyL = 252      # Frequency low 7 bits (bit7 == 0)
                                          463   keyH = 253      # Frequency high 8 bits
                                          464   oscL = 254      # Phase low 7 bits
                                          465   oscH = 255      # Phase high 8 bits
                                          466
                                          467   #-----------------------------------------------------------------------
                                          468   #  Memory layout
                                          469   #-----------------------------------------------------------------------
                                          470
                                          471   userCode = 0x0200       # Application vCPU code
                                          472   soundTable = 0x0700     # Wave form tables (doubles as right-shift-2 table)
                                          473   screenMemory = 0x0800   # Default start of screen memory: 0x0800 to 0x7fff
                                          474
                                          475   #-----------------------------------------------------------------------
                                          476   #  Application definitions
                                          477   #-----------------------------------------------------------------------
                                          478
                                          479   maxTicks = 30//2                # Duration of vCPU's slowest virtual opcode (ticks)
                                          480   minTicks = 14//2                # vcPU's fastest instruction
                                          481   v6502_maxTicks = 38//2          # Max duration of v6502 processing phase (ticks)
                                          482
                                          483   vCPU_overhead = 9               # Callee overhead of jumping in and out (cycles)
                                          484   v6502_overhead = 11             # Callee overhead for v6502 (cycles)
                                          485
                                          486   v6502_adjust = (v6502_maxTicks - maxTicks) + (v6502_overhead - vCPU_overhead)//2
                                          487   assert v6502_adjust >= 0        # v6502's overhead is a bit more than vCPU
                                          488
                                          489
                                          490   def runVcpu_new(n, ref=None):
                                          491     '''Macro to run interpreter for exactly n cycles.
                                          492        Argument `n' is the number of available Gigatron cycles.
                                          493        This is converted into interpreter ticks and takes into account
                                          494        the vCPU calling overheads. A `nop' is inserted when necessary
                                          495        for alignment between cycles and ticks.
                                          496        After `n' cycles, code execution resumes at 0x100+[vReturn].'''
                                          497
                                          498     if n is None:
                                          499       n, m = 127, 0               # longest slice
                                          500     else:
                                          501       n -= vCPU_overhead + 3
                                          502       assert n > 0
                                          503       n, m = n // 2 - maxTicks, n % 2
                                          504     assert n < 128
                                          505     assert n >= v6502_adjust
                                          506     print('runVcpu at $%04x net cycles %3s info %s' % (pc(), (n + maxTicks) * 2, ref))
                                          507     ld([vCpuSelect],Y)            #0 Allows us to use ctrl() just before runVcpu
                                          508     st(0,[0]) if m == 1 else None #? Tick alignment
                                          509     jmp(Y,'ENTER')                #3
                                          510     ld(n)                         #4
                                          511
                                          512
                                          513   #-----------------------------------------------------------------------
                                          514   #       v6502 definitions
                                          515   #-----------------------------------------------------------------------
                                          516
                                          517   # Registers are zero page variables
                                          518   v6502_PC        = vLR           # Program Counter
                                          519   v6502_PCL       = vLR+0         # Program Counter Low
                                          520   v6502_PCH       = vLR+1         # Program Counter High
                                          521   v6502_S         = vSP           # Stack Pointer (kept as "S+1")
                                          522   v6502_A         = vAC+0         # Accumulator
                                          523   v6502_BI        = vAC+1         # B Input Register (used by SBC)
                                          524   v6502_ADL       = sysArgs+0     # Low Address Register
                                          525   v6502_ADH       = sysArgs+1     # High Address Register
                                          526   v6502_IR        = sysArgs+2     # Instruction Register
                                          527   v6502_P         = sysArgs+3     # Processor Status Register (V flag in bit 7)
                                          528   v6502_Qz        = sysArgs+4     # Quick Status Register for Z flag
                                          529   v6502_Qn        = sysArgs+5     # Quick Status Register for N flag
                                          530   v6502_X         = sysArgs+6     # Index Register X
                                          531   v6502_Y         = sysArgs+7     # Index Register Y
                                          532   v6502_Tmp       = vTmp          # Scratch (may be clobbered outside v6502)
                                          533
                                          534   # MOS 6502 definitions for P register
                                          535   v6502_Cflag = 1                 # Carry Flag (unsigned overflow)
                                          536   v6502_Zflag = 2                 # Zero Flag (all bits zero)
                                          537   v6502_Iflag = 4                 # Interrupt Enable Flag (1=Disable)
                                          538   v6502_Dflag = 8                 # Decimal Enable Flag (aka BCD mode, 1=Enable)
                                          539   v6502_Bflag = 16                # Break (or PHP) Instruction Flag
                                          540   v6502_Uflag = 32                # Unused (always 1)
                                          541   v6502_Vflag = 64                # Overflow Flag (signed overflow)
                                          542   v6502_Nflag = 128               # Negative Flag (bit 7 of result)
                                          543
                                          544   # In emulation it is much faster to keep the V flag in bit 7
                                          545   # This can be corrected when importing/exporting with PHP, PLP, etc
                                          546   v6502_Vemu = 128
                                          547
                                          548   # On overflow:
                                          549   #       """Overflow is set if two inputs with the same sign produce
                                          550   #          a result with a different sign. Otherwise it is clear."""
                                          551   # Formula (without carry/borrow in!):
                                          552   #       (A ^ (A+B)) & (B ^ (A+B)) & 0x80
                                          553   # References:
                                          554   #       http://www.righto.com/2012/12/the-6502-overflow-flag-explained.html
                                          555   #       http://6502.org/tutorials/vflag.html
                                          556
                                          557   # Memory layout
                                          558   v6502_Stack     = 0x0000        # 0x0100 is already used in the Gigatron
                                          559   #v6502_NMI      = 0xfffa
                                          560   #v6502_RESET    = 0xfffc
                                          561   #v6502_IRQ      = 0xfffe
                                          562
                                          563   #-----------------------------------------------------------------------
                                          564   #
                                          565   #  $0000 ROM page 0: Boot
                                          566   #
                                          567   #-----------------------------------------------------------------------
                                          568
                                          569   align(0x100, size=0x80)
                                          570
                                          571   # Give a first sign of life that can be checked with a voltmeter
              address
              |    encoding
              |    |     instruction
              |    |     |    operands
              |    |     |    |
              V    V     V    V
              0000 0000  ld   $00         572   ld(0b0000)                      # LEDs |OOOO|
              0001 1880  ld   $80,out     573   ld(syncBits^hSync,OUT)          # Prepare XOUT update, hSync goes down, RGB to black
              0002 18c0  ld   $c0,out     574   ld(syncBits,OUT)                # hSync goes up, updating XOUT
                                          575
                                          576   # Setup I/O and RAM expander
              0003 c17f  ctrl $7f         577   ctrl(0b01111111)                # Reset signal (default state | 0x3)
              0004 c17c  ctrl $7c         578   ctrl(0b01111100)                # Disable SPI slaves, enable RAM, bank 1
                                          579   #      ^^^^^^^^
                                          580   #      |||||||`-- SCLK
                                          581   #      ||||||`--- Not connected
                                          582   #      |||||`---- /SS0
                                          583   #      ||||`----- /SS1
                                          584   #      |||`------ /SS2
                                          585   #      ||`------- /SS3
                                          586   #      |`-------- B0
                                          587   #      `--------- B1
                                          588   # bit15 --------- MOSI = 0
                                          589
                                          590   # Simple RAM test and size check by writing to [1<<n] and see if [0] changes or not.
              0005 0001  ld   $01         591   ld(1)                           # Quick RAM test and count
                                          592   label('.countMem0')
.countMem0:   0006 d601  st   [$01],y     593   st([memSize],Y)                 # Store in RAM and load AC in Y
              0007 00ff  ld   $ff         594   ld(255)
              0008 6900  xora [y,$00]     595   xora([Y,0])                     # Invert value from memory
              0009 ca00  st   [y,$00]     596   st([Y,0])                       # Test RAM by writing the new value
              000a c200  st   [$00]       597   st([0])                         # Copy result in [0]
              000b 6900  xora [y,$00]     598   xora([Y,0])                     # Read back and compare if written ok
              000c ec0c  bne  $000c       599   bne(pc())                       # Loop forever on RAM failure here
              000d 00ff  ld   $ff         600   ld(255)
              000e 6900  xora [y,$00]     601   xora([Y,0])                     # Invert memory value again
              000f ca00  st   [y,$00]     602   st([Y,0])                       # To restore original value
              0010 6100  xora [$00]       603   xora([0])                       # Compare with inverted copy
              0011 f015  beq  .countMem1  604   beq('.countMem1')               # If equal, we wrapped around
              0012 0101  ld   [$01]       605   ld([memSize])
              0013 fc06  bra  .countMem0  606   bra('.countMem0')               # Loop to test next address line
              0014 8200  adda ac          607   adda(AC)                        # Executes in the branch delay slot!
                                          608   label('.countMem1')
                                          609
                                          610   # Momentarily wait to allow for debouncing of the reset switch by spinning
                                          611   # roughly 2^15 times at 2 clocks per loop: 6.5ms@10MHz to 10ms@6.3MHz
                                          612   # Real-world switches normally bounce shorter than that.
                                          613   # "[...] 16 switches exhibited an average 1557 usec of bouncing, with,
                                          614   #  as I said, a max of 6200 usec" (From: http://www.ganssle.com/debouncing.htm)
                                          615   # Relevant for the breadboard version, as the kit doesn't have a reset switch.
                                          616
.countMem1:   0015 00ff  ld   $ff         617   ld(255)                         # Debounce reset button
                                          618   label('.debounce')
.debounce:    0016 c200  st   [$00]       619   st([0])
              0017 ec17  bne  $0017       620   bne(pc())
              0018 a001  suba $01         621   suba(1)                         # Branch delay slot
              0019 0100  ld   [$00]       622   ld([0])
              001a ec16  bne  .debounce   623   bne('.debounce')
              001b a001  suba $01         624   suba(1)                         # Branch delay slot
                                          625
                                          626   # Update LEDs (memory is present and counted, reset is stable)
              001c 0001  ld   $01         627   ld(0b0001)                      # LEDs |*OOO|
              001d 1880  ld   $80,out     628   ld(syncBits^hSync,OUT)
              001e 18c0  ld   $c0,out     629   ld(syncBits,OUT)
                                          630
                                          631   # Scan the entire RAM space to collect entropy for a random number generator.
                                          632   # The 16-bit address space is scanned, even if less RAM was detected.
              001f 0000  ld   $00         633   ld(0)                           # Collect entropy from RAM
              0020 d218  st   [$18],x     634   st([vAC+0],X)
              0021 d619  st   [$19],y     635   st([vAC+1],Y)
                                          636   label('.initEnt0')
.initEnt0:    0022 0106  ld   [$06]       637   ld([entropy+0])
              0023 f426  bge  .initEnt1   638   bpl('.initEnt1')
              0024 8d00  adda [y,x]       639   adda([Y,X])
              0025 60bf  xora $bf         640   xora(191)
                                          641   label('.initEnt1')
.initEnt1:    0026 c206  st   [$06]       642   st([entropy+0])
              0027 0107  ld   [$07]       643   ld([entropy+1])
              0028 f42b  bge  .initEnt2   644   bpl('.initEnt2')
              0029 8106  adda [$06]       645   adda([entropy+0])
              002a 60c1  xora $c1         646   xora(193)
                                          647   label('.initEnt2')
.initEnt2:    002b c207  st   [$07]       648   st([entropy+1])
              002c 1401  ld   $01,y       649   ld(1,Y)
                                          650   if WITH_128K_BOARD:
                                          651     adda([Y,entropy2])            # displaced third entropy byte
                                          652     st([Y,entropy2])
                                          653   else:
              002d 8108  adda [$08]       654     adda([entropy+2])             # preserved third entropy byte
              002e c208  st   [$08]       655     st([entropy+2])
              002f 1519  ld   [$19],y     656   ld([vAC+1],Y)
              0030 0118  ld   [$18]       657   ld([vAC+0])
              0031 8001  adda $01         658   adda(1)
              0032 ec22  bne  .initEnt0   659   bne('.initEnt0')
              0033 d218  st   [$18],x     660   st([vAC+0],X)
              0034 0119  ld   [$19]       661   ld([vAC+1])
              0035 8001  adda $01         662   adda(1)
              0036 ec22  bne  .initEnt0   663   bne('.initEnt0')
              0037 d619  st   [$19],y     664   st([vAC+1],Y)
                                          665
                                          666   # Update LEDs
              0038 0003  ld   $03         667   ld(0b0011)                      # LEDs |**OO|
              0039 1880  ld   $80,out     668   ld(syncBits^hSync,OUT)
              003a 18c0  ld   $c0,out     669   ld(syncBits,OUT)
                                          670
                                          671   # vCPU reset handler
              003b 0002  ld   $02         672   ld(hi('ENTER'))                 # vCPU is the active interpreter
              003c c205  st   [$05]       673   st([vCpuSelect])
              003d 00ee  ld   $ee         674   ld((vReset&255)-2)              # Setup reset handler
              003e c216  st   [$16]       675   st([vPC])
              003f 9002  adda $02,x       676   adda(2,X)
              0040 0001  ld   $01         677   ld(vReset>>8)
              0041 d617  st   [$17],y     678   st([vPC+1],Y)
              0042 dc35  st   $35,[y,x++] 679   st(lo('PREFIX35'),    [Y,Xpp])  # vReset
              0043 dc7d  st   $7d,[y,x++] 680   st(lo('RESET_v7'),    [Y,Xpp])
                                          681
                                          682   # Init key variables (Y=1)
              0044 0000  ld   $00         683   ld(0)
              0045 c200  st   [$00]       684   st([0])                         # Carry lookup ([0x80] in 1st line of vBlank)
              0046 c202  st   [$02]       685   st([channel])
              0047 c22c  st   [$2c]       686   st([soundTimer])
              0048 caf5  st   [y,$f5]     687   st([Y, vIrqCtx_v7])
              0049 caf6  st   [y,$f6]     688   st([Y, vIRQ_v5])
              004a caf7  st   [y,$f7]     689   st([Y, vIRQ_v5+1])
              004b caf9  st   [y,$f9]     690   st([Y, videoTop_v5])
              004c 00ff  ld   $ff         691   ld(255)                         # Setup serial input
              004d c20e  st   [$0e]       692   st([frameCount])
              004e c20f  st   [$0f]       693   st([serialRaw])
              004f c210  st   [$10]       694   st([serialLast])
              0050 c211  st   [$11]       695   st([buttonState])
              0051 c212  st   [$12]       696   st([resetTimer])                # resetTimer<0 when entering Main.gcl
              0052 007c  ld   $7c         697   ld(0x7c)
              0053 caf8  st   [y,$f8]     698   st([Y, ctrlBits])
              0054 0200  nop              699   st([ctrlVideo]) if WITH_128K_BOARD else nop()
              0055 0200  nop              700   st([ctrlCopy])  if WITH_128K_BOARD else nop()
                                          701
              0056 000f  ld   $0f         702   ld(0b1111)                      # LEDs |****|
              0057 1880  ld   $80,out     703   ld(syncBits^hSync,OUT)
              0058 18c0  ld   $c0,out     704   ld(syncBits,OUT)
              0059 c213  st   [$13]       705   st([xout])                      # Setup for control by video loop
              005a c214  st   [$14]       706   st([xoutMask])
                                          707
                                          708   # Start
              005b 1401  ld   $01,y       709   ld(hi('startVideo'),Y)          # Enter video loop at vertical blank
              005c e003  jmp  y,$03       710   jmp(Y,'startVideo')
              005d c22e  st   [$2e]       711   st([ledState_v2])               # Setting to 1..126 means "stopped"
                                          712
                                          713   #-----------------------------------------------------------------------
                                          714   # Soft reset
                                          715   #-----------------------------------------------------------------------
                                          716
                                          717   # Resets the gigatron without breaking the video loop.
                                          718   # This mostly consists of executing Reset.gt1.
                                          719   #
                                          720   # This used to be achieved with a SYS_Reset_88 that was removed
                                          721   # from interface.json for ROMv5a in order to prefer achieving this
                                          722   # by jumping to vReset. Instead of a SYS call, this is now
                                          723   # achieved by a secret vCPU instruction RESET_v7 that frees
                                          724   # the [1f2-1f5] space for other purposes.
                                          725
                                          726   # ROM type (see also Docs/GT1-files.txt)
                                          727   romTypeValue = symbol('romTypeValue_DEVROM')
                                          728
                                          729   label('softReset#24')
softReset#24: 005e 0000  ld   $00         730   ld(0)                           #24
              005f c21c  st   [$1c]       731   st([vSP])                       #25 vSP
              0060 c21d  st   [$1d]       732   st([vSP+1])                     #26
              0061 1401  ld   $01,y       733   ld(hi('videoTop_v5'),Y)         #27
              0062 caf9  st   [y,$f9]     734   st([Y,lo('videoTop_v5')])       #28 Show all 120 pixel lines
              0063 caf5  st   [y,$f5]     735   st([Y,vIrqCtx_v7])              #29
              0064 caf6  st   [y,$f6]     736   st([Y,vIRQ_v5])                 #30 Disable vIRQ dispatch
              0065 caf7  st   [y,$f7]     737   st([Y,vIRQ_v5+1])               #31
              0066 c22c  st   [$2c]       738   st([soundTimer])                #32 soundTimer
              0067 c21a  st   [$1a]       739   st([vLR])                       #33 vLR
              0068 c21b  st   [$1b]       740   st([vLR+1])                     #34
                                          741   st([videoModeC]) if WITH_512K_BOARD else None
              0069 007c  ld   $7c         742   ld(0x7c)                        #35/36
              006a caf8  st   [y,$f8]     743   st([Y,ctrlBits])                #36/37
              006b 0200  nop              744   st([ctrlVideo])  if WITH_128K_BOARD else nop()
              006c 0200  nop              745   st([ctrlCopy])   if WITH_128K_BOARD else nop()
              006d 00f6  ld   $f6         746   ld('nopixels')                  #39/40
              006e c20b  st   [$0b]       747   st([videoModeC]) if not WITH_512K_BOARD else None
              006f c20a  st   [$0a]       748   st([videoModeB])                #41
              0070 c20c  st   [$0c]       749   st([videoModeD])                #42
                                          750   # Set romTypeValue
                                          751   assert (romTypeValue & 7) == 0
              0071 00f8  ld   $f8         752   ld(romTypeValue)                #43 Set ROM type/version and clear channel mask
              0072 c221  st   [$21]       753   st([romType])                   #44
                                          754   # Reset expansion board
              0073 c17f  ctrl $7f         755   ctrl(0b01111111)                #45 Reset signal (default state | 0x3)
              0074 c17c  ctrl $7c         756   ctrl(0b01111100)                #46 Default state.
                                          757   # Adjust ticks
              0075 0115  ld   [$15]       758   ld([vTicks])                    #47 Always load after ctrl
              0076 80ed  adda $ed         759   adda(-38/2)                     #48-38=10
              0077 c215  st   [$15]       760   st([vTicks])                    #11
              0078 00e5  ld   $e5         761   ld('Reset')                     #12 Reset.gt1 from EPROM
              0079 c224  st   [$24]       762   st([sysArgs+0])                 #13
              007a 00e8  ld   $e8         763   ld(hi('Reset'))                 #14
              007b 1420  ld   $20,y       764   ld(hi('sys_Exec'),Y)            #15
              007c e009  jmp  y,$09       765   jmp(Y,'sys_Exec')               #16
              007d c225  st   [$25]       766   st([sysArgs+1])                 #17
                                          767
                                          768
                                          769
                                          770   #-----------------------------------------------------------------------
                                          771   # Placeholders for future SYS functions. This works as a kind of jump
                                          772   # table. The indirection allows SYS implementations to be moved around
                                          773   # between ROM versions, at the expense of 2 clock cycles (or 1). When
                                          774   # the function is not present it just acts as a NOP. Of course, when a
                                          775   # SYS function must be patched or extended it needs to have budget for
                                          776   # that in its declared maximum cycle count.
                                          777   #
                                          778   # Technically the same goal can be achieved by starting each function
                                          779   # with 2 nop's, or by overdeclaring their duration in the first place
                                          780   # (a bit is still wise to do). But this can result in fragmentation
                                          781   # of future ROM images. The indirection avoids that.
                                          782   #
                                          783   # An added advantage of having these in ROM page 0 is that it saves one
                                          784   # byte when setting sysFn: LDI+STW (4 bytes) instead of LDWI+STW (5 bytes)
                                          785   #-----------------------------------------------------------------------
                                          786
              007e 0200  nop              787   align(0x80, size=0x80)
              007f 0200  nop
                                          788   assert pc() == 0x80
                                          789
              0080 1403  ld   $03,y       790   ld(hi('REENTER'),Y)             #15 slot 0x80
              0081 e0cb  jmp  y,$cb       791   jmp(Y,'REENTER')                #16
              0082 00f6  ld   $f6         792   ld(-20/2)                       #17
                                          793
              0083 1403  ld   $03,y       794   ld(hi('REENTER'),Y)             #15 slot 0x83
              0084 e0cb  jmp  y,$cb       795   jmp(Y,'REENTER')                #16
              0085 00f6  ld   $f6         796   ld(-20/2)                       #17
                                          797
              0086 1403  ld   $03,y       798   ld(hi('REENTER'),Y)             #15 slot 0x86
              0087 e0cb  jmp  y,$cb       799   jmp(Y,'REENTER')                #16
              0088 00f6  ld   $f6         800   ld(-20/2)                       #17
                                          801
              0089 1403  ld   $03,y       802   ld(hi('REENTER'),Y)             #15 slot 0x89
              008a e0cb  jmp  y,$cb       803   jmp(Y,'REENTER')                #16
              008b 00f6  ld   $f6         804   ld(-20/2)                       #17
                                          805
              008c 1403  ld   $03,y       806   ld(hi('REENTER'),Y)             #15 slot 0x8c
              008d e0cb  jmp  y,$cb       807   jmp(Y,'REENTER')                #16
              008e 00f6  ld   $f6         808   ld(-20/2)                       #17
                                          809
              008f 1403  ld   $03,y       810   ld(hi('REENTER'),Y)             #15 slot 0x8f
              0090 e0cb  jmp  y,$cb       811   jmp(Y,'REENTER')                #16
              0091 00f6  ld   $f6         812   ld(-20/2)                       #17
                                          813
              0092 1403  ld   $03,y       814   ld(hi('REENTER'),Y)             #15 slot 0x92
              0093 e0cb  jmp  y,$cb       815   jmp(Y,'REENTER')                #16
              0094 00f6  ld   $f6         816   ld(-20/2)                       #17
                                          817
              0095 1403  ld   $03,y       818   ld(hi('REENTER'),Y)             #15 slot 0x95
              0096 e0cb  jmp  y,$cb       819   jmp(Y,'REENTER')                #16
