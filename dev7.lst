                                          1075  #-----------------------------------------------------------------------
                                          1076  # Extension SYS_ScanMemory_v6_50
                                          1077  #-----------------------------------------------------------------------
                                          1078
                                          1079  # SYS function for searching bytes in memory.
                                          1080  # This function examines bytes starting from address sysArgs[01] and
                                          1081  # stops when encountering a byte equal to either sysArgs[2] or
                                          1082  # sysArgs[3], or when vACL bytes have been examined, whichever comes
                                          1083  # first.  It does not cross page boudaries but wraps around in the
                                          1084  # page, leaving sysArgs[1] unchanged.
                                          1085  #
                                          1086  # Inputs:
                                          1087  #   sysArgs[01]        Start address of the string
                                          1088  #   sysArgs[23]        Bytes to search
                                          1089  #   vACL               Length of the string (0 means 256)
                                          1090  #
                                          1091  # If a matching byte is found, its address is returned in vAC and sysArgs[01].
                                          1092  # Otherwise, zero is returned in vAC and sysArgs[0] point right after the string.
                                          1093
                                          1094  label('SYS_ScanMemory_v6_50')
SYS_ScanMemory_v6_50:
              00e6 1412  ld   $12,y       1095  ld(hi('sys_ScanMemory'),Y)      #15 slot 0xe6
              00e7 e09a  jmp  y,$9a       1096  jmp(Y,'sys_ScanMemory')         #16
              00e8 1525  ld   [$25],y     1097  ld([sysArgs+1],Y)               #17
                                          1098
                                          1099
                                          1100  #-----------------------------------------------------------------------
                                          1101  # Extension SYS_CopyMemory_v6_80
                                          1102  #-----------------------------------------------------------------------
                                          1103
                                          1104  # SYS function for copying 1..256 bytes
                                          1105  #
                                          1106  # sysArgs[0:1]    Destination address
                                          1107  # sysArgs[2:3]    Source address
                                          1108  # vAC[0]          Count (0 means 256)
                                          1109  #
                                          1110  # Doesn't cross page boundaries.
                                          1111  # Overwrites sysArgs[4:7] and vLR.
                                          1112
                                          1113  label('SYS_CopyMemory_v6_80')
SYS_CopyMemory_v6_80:
              00e9 1413  ld   $13,y       1114  ld(hi('sys_CopyMemory'),Y)       # 15 slot 0xe9
              00ea e000  jmp  y,$00       1115  jmp(Y, 'sys_CopyMemory')         # 16
              00eb 0118  ld   [$18]       1116  ld([vAC])                        # 17
                                          1117
                                          1118  #-----------------------------------------------------------------------
                                          1119  # Extension SYS_CopyMemoryExt_v6_100
                                          1120  #-----------------------------------------------------------------------
                                          1121
                                          1122  # SYS function for copying 1..256 bytes across banks
                                          1123  #
                                          1124  # sysArgs[0:1]  Destination address
                                          1125  # sysArgs[2:3]  Source address
                                          1126  # vAC[0]        Count (0 means 256)
                                          1127  # vAC[1]        Bits 7 and 6 contain the destination bank number,
                                          1128  #               and bits 5 and 4 the source bank number.
                                          1129  #
                                          1130  # Doesn't cross page boundaries.
                                          1131  # Overwrites sysArgs[4:7], vLR, and vTmp.
                                          1132  # Temporarily deselect all SPI devices.
                                          1133  # Should not call without expansion board
                                          1134
                                          1135  label('SYS_CopyMemoryExt_v6_100')
