LSLW:         03e9 1404  ld   $04,y       2538  ld(hi('lslw#13'),Y)             #10
              03ea e02d  jmp  y,$2d       2539  jmp(Y,'lslw#13')                #11
              03eb 0116  ld   [$16]       2540  ld([vPC])                       #12
