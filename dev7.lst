                                          898   #-----------------------------------------------------------------------
                                          899   # Extension SYS_Exec_88: Load code from ROM into memory and execute it
                                          900   #-----------------------------------------------------------------------
                                          901   #
                                          902   # This loads the vCPU code with consideration of the current vSP
                                          903   # Used during reset, but also for switching between applications or for
                                          904   # loading data from ROM from within an application (overlays).
                                          905   #
                                          906   # ROM stream format is
                                          907   #  [<addrH> <addrL> <n&255> n*<byte>]* 0 [<execH> <execL>]
                                          908   # on top of lookup tables.
                                          909   #
                                          910   #       sysArgs[0:1]    ROM pointer (in)
                                          911   #       sysArgs[2:3]    RAM pointer (changed) Execution address (out)
                                          912   #       sysArgs[4]      Byte counter (changed)
                                          913   #       sysArgs[7]      FSM state (changed)
                                          914   #       vLR==0          vCPU continues at GT1 execution address (in)
                                          915   #       vLR!=0          vCPU continues at vLR (in)
                                          916
                                          917   label('SYS_Exec_88')
SYS_Exec_88:  00ad 1420  ld   $20,y       918   ld(hi('sys_Exec'),Y)            #15
              00ae e009  jmp  y,$09       919   jmp(Y,'sys_Exec')               #16
              00af 0200  nop              920   nop()                           #17
                                          921
                                          922   #-----------------------------------------------------------------------
                                          923   # Extension SYS_Loader_DEVROM_44: Load code from serial input and execute
                                          924   #-----------------------------------------------------------------------
                                          925   #
                                          926   # This loads vCPU code and data presented on the serial port according
                                          927   # to the loader protocol then jumps to the avertised execution
                                          928   # address. This call never returns.
                                          929   #
                                          930   # Set sysArgs[0] to 0xc to enable visual feedback in the pixel
                                          931   # row located in page sysArgs[1]. This is automatically
                                          932   # disabled if bytes are loaded in the feedback area.
                                          933   #
                                          934   #       sysArgs[0]      Zero to disable echo (0x00 or ox0c) (in)
                                          935   #       sysArgs[1]      Echo row (0x59) (in)
                                          936   #
                                          937   # Credits: The first native loader was written for ROMvX0 by at67.
                                          938   #
                                          939   # Loader protocol
                                          940   # ---------------
                                          941   # The data is divided into chunks of at most 60 bytes to be loaded at
                                          942   # contiguous addresses inside a same gigatron memory page. Each chunk
                                          943   # is transmitted over the serial port (IN) synchronously with the
                                          944   # video signal, one chunk per frame. Each byte of the chunk must be
                                          945   # read from the IN port when videoY takes specific values:
                                          946   #
                                          947   #  videoY    Data
                                          948   #   207      protocol signature: 'L'
                                          949   #   219      chunk length (low 6 bits) or zero to execute.
                                          950   #   235      chunk address (l) or execution address (l) if len=0
                                          951   #   251      chunk address (h) or execution address (h)  if len=0
                                          952   #   2        chunk byte 0
                                          953   #   6        chunk byte 1
                                          954   #  ....
                                          955   #   2+4*k    chunk byte k
                                          956
              00b0 1420  ld   $20,y       957   ld(hi('sys_Loader'),Y)          #15 slot 0xb0
              00b1 e015  jmp  y,$15       958   jmp(Y,'sys_Loader')             #16
              00b2 0124  ld   [$24]       959   ld([sysArgs+0])                 #17
                                          960
                                          961   #-----------------------------------------------------------------------
                                          962   # More placeholders for future SYS functions
                                          963   #-----------------------------------------------------------------------
                                          964
