                                          7215  label(fsmLab('LUP#10'))
fsm16:LUP#10: 1632 c224  st   [$24]       7216  st([sysArgs+0])                 #10
              1633 0125  ld   [$25]       7217  ld([sysArgs+1])                 #11
              1634 8001  adda $01         7218  adda(1)                         #12
              1635 c225  st   [$25]       7219  st([sysArgs+1])                 #13
              1636 00fa  ld   $fa         7220  ld(250)                         #14
                                          7221  label(fsmLab('LUP#15'))
fsm16:LUP#15: 1637 e0fb  jmp  y,$fb       7222  jmp(Y,251)                      #15
              1638 0200  nop              7223  nop()                           #16
