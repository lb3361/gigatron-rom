vbSample#49:  0190 0103  ld   [$03]       1451      ld([sample])                #49
              0191 400f  ora  $0f         1452      ora(ledBits)                #50 New sound sample is ready
              0192 2114  anda [$14]       1453      anda([xoutMask])            #51
              0193 c213  st   [$13]       1454      st([xout])                  #52
              0194 c003  st   $03,[$03]   1455      st(sample, [sample])        #53 Reset for next sample
              0195 1505  ld   [$05],y     1456      runVcpu_new(vBlankEnterCyc-54,
              0196 e0ff  jmp  y,$ff
              0197 0034  ld   $34
                                          1457              '--C- line 3-39')   #54 Application cycles (vBlank scan lines with sound sample update)
