                                          4492  #-----------------------------------------------------------------------
                                          4493  #       MOS 6502 emulator
                                          4494  #-----------------------------------------------------------------------
                                          4495
                                          4496  # Some quirks:
                                          4497  # - Stack in zero page instead of page 1
                                          4498  # - No interrupts
                                          4499  # - No decimal mode (may never be added). D flag is emulated but ignored.
                                          4500  # - BRK switches back to running 16-bits vCPU
                                          4501  # - Illegal opcodes map to BRK, but can read ghost operands before trapping
                                          4502  # - Illegal opcode $ff won't be trapped and cause havoc instead
                                          4503
                                          4504  # Big things TODO:
                                          4505  # XXX Tuning, put most frequent instructions in the primary page
                                          4506
                                          4507  label('v6502_ror')
                                          4508  assert v6502_Cflag == 1
v6502_ror:    0d8f 1525  ld   [$25],y     4509  ld([v6502_ADH],Y)               #12
              0d90 00fc  ld   $fc         4510  ld(-46//2+v6502_maxTicks)       #13 Is there enough time for the excess ticks?
              0d91 8115  adda [$15]       4511  adda([vTicks])                  #14
              0d92 e8a4  blt  .recheck17  4512  blt('.recheck17')               #15
              0d93 0127  ld   [$27]       4513  ld([v6502_P])                   #16 Transfer C to "bit 8"
              0d94 2001  anda $01         4514  anda(1)                         #17
              0d95 807f  adda $7f         4515  adda(127)                       #18
              0d96 2080  anda $80         4516  anda(128)                       #19
              0d97 c219  st   [$19]       4517  st([v6502_BI])                  #20 The real 6502 wouldn't use BI for this
