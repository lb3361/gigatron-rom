                                          1324    st([ctrlCopy],X)              #+2
                                          1325    ctrl(X)                       #+3
                                          1326    ora([videoSync0])             #+4 0xc0 (must load after ctrl)
                                          1327    anda(0x7f)                    #+5
                                          1328    st([ctrlVideo])               #+6
