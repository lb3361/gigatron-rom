                                          5469  # `v6502_RESUME' is the interpreter's secondary entry point for when
                                          5470  # the opcode and operands were already fetched, just before the last hPulse.
                                          5471  # It must be at $xxff, prefably somewhere in v6502's own code pages.
                                          5472
                                          5473  fillers(until=0xff)
                                          5474  label('v6502_RESUME')
                                          5475  assert (pc()&255) == 255
