              150d e0a9  jmp  y,$a9       6787  jmp(Y,'fsmOP#8')                #6 + overlap
                                          6788
                                          6789  # Usage fsmAsm('XOR', arg)
                                          6790  # - vACL += arg with arg=d or arg=[d]
