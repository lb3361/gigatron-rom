              01b8 ecbb  bne  $01bb       1535  bne(pc()+3)                     #72
              01b9 fcbc  bra  $01bc       1536  bra(pc()+3)                     #73
              01ba 0001  ld   $01         1537  ld('videoA')                    #74
              01bb 00ec  ld   $ec         1538  ld('videoF')                    #74(!)
              01bc c20d  st   [$0d]       1539  st([nextVideo])                 #75
              01bd 0102  ld   [$02]       1540  ld([channel])                   #76 Normalize channel for robustness
              01be 2003  anda $03         1541  anda(0b00000011)                #77
              01bf c202  st   [$02]       1542  st([channel])                   #78
