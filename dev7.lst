                                          2423  label('MOVW_v7')
MOVW_v7:      03bb c22b  st   [$2b]       2424  st([sysArgs+7])                 #10 destination operand
              03bc de00  st   [y,x++]     2425  st([Y,Xpp])                     #11
              03bd 0d00  ld   [y,x]       2426  ld([Y,X])                       #12 source operand
              03be 1420  ld   $20,y       2427  ld(hi('movw#16'),Y)             #13
              03bf e079  jmp  y,$79       2428  jmp(Y,'movw#16')                #14
              03c0 9001  adda $01,x       2429  adda(1,X)                       #15
