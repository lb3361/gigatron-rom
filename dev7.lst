                                          2933  # Extension SYS_VDrawBits_134:
                                          2934  #-----------------------------------------------------------------------
                                          2935
                                          2936  # Draw slice of a character, 8 pixels vertical
                                          2937  #
                                          2938  # Variables:
                                          2939  #       sysArgs[0]      Color 0 "background" (in)
                                          2940  #       sysArgs[1]      Color 1 "pen" (in)
                                          2941  #       sysArgs[2]      8 bits, highest bit first (in, changed)
                                          2942  #       sysArgs[4:5]    Position on screen (in)
                                          2943
