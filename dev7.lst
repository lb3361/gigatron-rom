                                          1528  # Sets vReturn and nextVideo for visible lines
.restart#66:  01b2 00ff  ld   $ff         1529  ld(lo('vVisibEnter'))           #66
              01b3 c21e  st   [$1e]       1530  st([vReturn])                   #67
              01b4 1401  ld   $01,y       1531  ld(videoTop_v5>>8,Y)            #68
              01b5 09f9  ld   [y,$f9]     1532  ld([Y,videoTop_v5])             #69
              01b6 c209  st   [$09]       1533  st([videoY])                    #70
