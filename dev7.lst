              1102 140f  ld   $0f,y       5481  ld(hi('v6502_execute'),Y)       #3
              1103 e126  jmp  y,[$26]     5482  jmp(Y,[v6502_IR])               #4
              1104 fcff  bra  $ff         5483  bra(255)                        #5
