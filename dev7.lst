              150b e09f  jmp  y,$9f       6781  jmp(Y,'fsmST#8')                #6 + overlap
                                          6782
                                          6783  # Usage fsmAsm('LD', arg)
                                          6784  # - vACL = arg with arg=d or arg=[d]
                                          6785  label(fsmLab('LD'))
